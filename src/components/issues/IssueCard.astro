---
import type { Issue } from "../../content/issues";
import { issueCategoryLabel } from "../../content/issues";
import { withBase } from "../../lib/paths";

interface Props {
  issue: Issue;
}

const { issue } = Astro.props;
---

<article
  class="issue-card"
  id={`issue-${issue.number}`}
  data-category={issue.category}
  data-issue-card
>
  <button type="button" class="issue-card__toggle" data-issue-toggle aria-expanded="false">
    <span class="issue-card__num">{String(issue.number).padStart(2, "0")}</span>
    <span class="issue-card__main">
      <span class="issue-card__meta">
        <span class="issue-card__cat">{issueCategoryLabel[issue.category]}</span>
        <span>Issue {issue.number} of 10</span>
      </span>
      <span class="issue-card__title">{issue.title}</span>
      <span class="issue-card__flyer">{issue.shortBlurb}</span>
    </span>
    <span class="issue-card__chevron" aria-hidden="true"></span>
  </button>

  <div class="issue-card__panel" hidden data-issue-panel>
    {issue.body.map((paragraph) => (
      <p>{paragraph}</p>
    ))}
    <a class="issue-card__link" href={withBase(`/issues/${issue.slug}`)}>Open full issue page →</a>
  </div>
</article>

<style>
  .issue-card {
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--white) 72%, var(--cream));
    overflow: hidden;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .issue-card[hidden] {
    display: none !important;
  }

  .issue-card.is-open {
    box-shadow: 0 10px 28px color-mix(in srgb, var(--ink) 8%, transparent);
  }

  .issue-card__toggle {
    width: 100%;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 0.85rem;
    align-items: start;
    text-align: left;
    border: 0;
    background: transparent;
    padding: 1.1rem 1.15rem;
    cursor: pointer;
    font: inherit;
    color: inherit;
  }

  .issue-card__num {
    font-family: var(--font-display);
    font-size: 1.85rem;
    line-height: 1;
    color: var(--green);
    font-weight: 550;
    padding-top: 0.1rem;
  }

  .issue-card__main {
    display: grid;
    gap: 0.35rem;
    min-width: 0;
  }

  .issue-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--muted);
  }

  .issue-card__cat {
    color: var(--purple);
  }

  .issue-card__title {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2.4vw, 1.45rem);
    line-height: 1.2;
    font-weight: 550;
  }

  .issue-card__flyer {
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.45;
  }

  .issue-card__chevron {
    width: 0.55rem;
    height: 0.55rem;
    margin-top: 0.55rem;
    border-right: 2px solid var(--green);
    border-bottom: 2px solid var(--green);
    transform: rotate(45deg);
    transition: transform 0.2s ease;
  }

  .issue-card.is-open .issue-card__chevron {
    transform: rotate(-135deg);
    margin-top: 0.75rem;
  }

  .issue-card__panel {
    padding: 0 1.15rem 1.2rem 1.15rem;
    display: grid;
    gap: 0.65rem;
  }

  .issue-card__panel[hidden] {
    display: none !important;
  }

  .issue-card__panel p {
    margin: 0;
    color: var(--ink);
    font-size: 0.95rem;
  }

  .issue-card__link {
    color: var(--green);
    font-weight: 600;
    text-decoration: none;
    width: fit-content;
    margin-top: 0.25rem;
  }

  .issue-card__link:hover {
    color: var(--purple);
  }

  @media (max-width: 560px) {
    .issue-card__toggle {
      grid-template-columns: auto minmax(0, 1fr);
    }

    .issue-card__chevron {
      display: none;
    }
  }
</style>
