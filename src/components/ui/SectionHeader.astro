---
interface Props {
  eyebrow?: string;
  title: string;
  align?: "left" | "center";
  class?: string;
}

const { eyebrow, title, align = "left", class: className = "" } = Astro.props;
---

<header class:list={["section-header", `section-header--${align}`, className]}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2>{title}</h2>
  <div class="section-header__body">
    <slot />
  </div>
</header>

<style>
  .section-header {
    display: grid;
    gap: 0.55rem;
    margin-bottom: 1.5rem;
  }

  .section-header--center {
    text-align: center;
    justify-items: center;
  }

  .section-header h2 {
    font-size: clamp(1.85rem, 3.5vw, 2.45rem);
    color: var(--ink);
    max-width: 20ch;
  }

  .section-header--center h2 {
    max-width: 22ch;
  }

  .section-header__body {
    color: var(--muted);
    max-width: 42rem;
  }

  .section-header--center .section-header__body {
    max-width: 40rem;
  }
</style>
