---
import type { VenueInfo } from "../../content/events";

interface Props {
  venue: VenueInfo;
  /** Show greeter / parking note under the card. Default true. */
  showNote?: boolean;
  /** Narrower card for embedding under event meta. */
  narrow?: boolean;
}

const { venue, showNote = true, narrow = false } = Astro.props;
---

<div class:list={["location-card-wrap", { "location-card-wrap--narrow": narrow }]}>
  <article class="location-card">
    <a
      class="location-card__media"
      href={venue.mapsUrl}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`Open directions to ${venue.building} in Google Maps`}
    >
      <img src={venue.image} alt={venue.imageAlt} width="400" height="320" loading="lazy" />
    </a>
    <div class="location-card__body">
      <p class="location-card__building">{venue.building}</p>
      <p class="location-card__campus">{venue.campus}</p>
      <p class="location-card__coords">{venue.coordinates}</p>
      <p class="location-card__place">{venue.city}</p>
      <p class="location-card__zip">{venue.zip}</p>
      <a class="location-card__maps" href={venue.mapsUrl} target="_blank" rel="noopener noreferrer">
        {venue.mapsLabel}
        <span class="visually-hidden"> (opens in Google Maps)</span>
      </a>
    </div>
  </article>
  {
    showNote && (
      <p class="location-card__note muted">{venue.greeterNote}</p>
    )
  }
</div>

<style>
  .location-card-wrap {
    display: grid;
    gap: 0.55rem;
    max-width: 36rem;
    width: 100%;
  }

  .location-card-wrap--narrow {
    max-width: 26rem;
  }

  .location-card {
    display: grid;
    grid-template-columns: minmax(9rem, 0.75fr) minmax(0, 1.45fr);
    align-items: stretch;
    overflow: hidden;
    border-radius: 1rem;
    background: color-mix(in srgb, var(--white) 92%, var(--cream));
    border: 1px solid color-mix(in srgb, var(--ink) 8%, transparent);
    box-shadow: 0 8px 22px color-mix(in srgb, var(--ink) 7%, transparent);
  }

  .location-card-wrap--narrow .location-card {
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
  }

  .location-card__media {
    position: relative;
    margin: 0;
    display: block;
    align-self: stretch;
    min-height: 6.5rem;
    background: color-mix(in srgb, var(--green-light) 30%, white);
    text-decoration: none;
    overflow: hidden;
  }

  .location-card__media:hover img {
    opacity: 0.92;
  }

  .location-card__media img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 28%;
    transition: opacity 0.15s ease;
  }

  .location-card__body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.08rem;
    padding: 0.65rem 1rem;
  }

  .location-card__building {
    margin: 0;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--green);
  }

  .location-card__campus {
    margin: 0 0 0.15rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--ink);
  }

  .location-card__coords {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--ink);
    letter-spacing: -0.01em;
  }

  .location-card__place,
  .location-card__zip {
    margin: 0;
    font-size: 0.84rem;
    line-height: 1.25;
    color: var(--muted);
  }

  .location-card__maps {
    margin-top: 0.25rem;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--blue);
    text-decoration: none;
  }

  .location-card__maps:hover {
    text-decoration: underline;
  }

  .location-card__note {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.45;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 520px) {
    .location-card {
      grid-template-columns: 1fr;
    }

    .location-card__media img {
      min-height: 0;
      aspect-ratio: 16 / 9;
      height: auto;
    }
  }
</style>
