---
interface Stat {
  value: string;
  label: string;
  color: "green-light" | "purple" | "blue" | "green";
}

interface Props {
  stats: readonly Stat[];
}

const { stats } = Astro.props;
const colorMap = {
  "green-light": "var(--green-light)",
  purple: "var(--purple)",
  blue: "var(--blue)",
  green: "var(--green)",
};
---

<ul class="stat-row">
  {
    stats.map((stat) => (
      <li>
        <p class="stat-row__value" style={`color: ${colorMap[stat.color]}`}>
          {stat.value}
        </p>
        <p class="stat-row__label">{stat.label}</p>
      </li>
    ))
  }
</ul>

<style>
  .stat-row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    list-style: none;
    margin-top: 1.35rem;
  }

  .stat-row__value {
    font-family: var(--font-display);
    font-size: clamp(1.55rem, 2.5vw, 2rem);
    line-height: 1.1;
  }

  .stat-row__label {
    margin-top: 0.3rem;
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    line-height: 1.35;
  }

  @media (max-width: 640px) {
    .stat-row {
      grid-template-columns: 1fr;
    }
  }
</style>
