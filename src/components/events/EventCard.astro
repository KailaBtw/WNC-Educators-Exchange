---
import type { EventItem } from "../../content/events";
import Button from "../ui/Button.astro";

interface Props {
  event: EventItem;
}

const { event } = Astro.props;
const primaryHref =
  event.status === "upcoming" && event.registerUrl
    ? event.registerUrl
    : `/events/${event.slug}`;
const primaryLabel = event.status === "upcoming" ? "Register" : "View event";
const primaryExternal = event.status === "upcoming";
---

<article class="event-card">
  <a class="event-card__image-link" href={`/events/${event.slug}`}>
    <img src={event.images[0]?.src} alt={event.images[0]?.alt ?? event.title} />
  </a>
  <div class="event-card__body">
    <p class="event-card__category">{event.category}</p>
    <h3>{event.title}</h3>
    <p class="event-card__summary">{event.summary}</p>
    <div class="event-card__actions">
      <Button href={primaryHref} variant="quiet" external={primaryExternal}>{primaryLabel}</Button>
      {
        event.status === "upcoming" && (
          <Button href={`/events/${event.slug}`} variant="quiet">
            Program
          </Button>
        )
      }
    </div>
  </div>
</article>

<style>
  .event-card {
    display: flex;
    flex-direction: column;
    min-height: 100%;
  }

  .event-card__image-link {
    border-radius: var(--radius-lg);
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: color-mix(in srgb, var(--green-light) 35%, white);
  }

  .event-card__image-link img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.45s ease;
  }

  .event-card__image-link:hover img {
    transform: scale(1.04);
  }

  .event-card__body {
    padding-top: 1rem;
    display: grid;
    grid-template-rows: auto minmax(3.4rem, auto) 1fr auto;
    gap: 0.45rem;
    flex: 1;
  }

  .event-card__category {
    color: var(--blue);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 700;
  }

  .event-card h3 {
    font-size: 1.45rem;
    line-height: 1.2;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .event-card__summary {
    color: var(--muted);
    font-size: 0.95rem;
  }

  .event-card__actions {
    margin-top: auto;
    display: flex;
    justify-content: flex-end;
    gap: 0.35rem;
    padding-top: 0.35rem;
  }

  .event-card__actions :global(.btn) {
    font-size: 1.05rem;
    min-height: 2.6rem;
    padding: 0.45rem 1rem;
  }
</style>
