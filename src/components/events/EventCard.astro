---
import type { EventItem } from "../../content/events";
import Button from "../ui/Button.astro";

interface Props {
  event: EventItem;
}

const { event } = Astro.props;
const primaryHref =
  event.status === "upcoming" && event.registerUrl
    ? event.registerUrl
    : `/events/${event.slug}`;
const primaryLabel = event.status === "upcoming" ? "Register" : "View event";
const primaryExternal = event.status === "upcoming";
---

<article class="event-card">
  <a class="event-card__image-link" href={`/events/${event.slug}`}>
    <img src={event.images[0]?.src} alt={event.images[0]?.alt ?? event.title} />
  </a>
  <div class="event-card__body">
    <div class="event-card__meta">
      <p class="event-card__category">{event.category}</p>
      <p class="event-card__date">{event.dateLabel}</p>
    </div>
    <h3>{event.title}</h3>
    <p class="event-card__summary">{event.summary}</p>
    <div class="event-card__actions">
      <Button href={primaryHref} variant="ghost" external={primaryExternal}>{primaryLabel}</Button>
      {
        event.status === "upcoming" && (
          <Button href={`/events/${event.slug}`} variant="ghost">
            Program
          </Button>
        )
      }
    </div>
  </div>
</article>

<style>
  .event-card {
    display: flex;
    flex-direction: column;
    min-height: 100%;
  }

  .event-card__image-link {
    border-radius: var(--radius-lg);
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: color-mix(in srgb, var(--green-light) 35%, white);
  }

  .event-card__image-link img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.45s ease;
  }

  .event-card__image-link:hover img {
    transform: scale(1.04);
  }

  .event-card__body {
    padding-top: 1rem;
    display: grid;
    gap: 0.55rem;
    flex: 1;
  }

  .event-card__meta {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    align-items: baseline;
  }

  .event-card__category {
    color: var(--blue);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 700;
  }

  .event-card__date {
    color: var(--muted);
    font-size: 0.85rem;
  }

  .event-card h3 {
    font-size: 1.55rem;
  }

  .event-card__summary {
    color: var(--muted);
    font-size: 0.98rem;
  }

  .event-card__actions {
    margin-top: auto;
    display: flex;
    justify-content: flex-end;
    gap: 0.75rem;
    padding-top: 0.5rem;
  }
</style>
