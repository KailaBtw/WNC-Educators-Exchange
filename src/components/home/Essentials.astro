---
import { issues, issueCategoryLabel } from "../../content/issues";
import { schoolPractices } from "../../content/schools";
import { site } from "../../content/site";

const issuePreview = issues.slice(0, 3);
const practicePreview = schoolPractices.slice(0, 3);
---

<section class="section unify" id="issues-home">
  <div class="container">
    <article class="unify-card">
      <button
        type="button"
        class="unify-card__media unify-card__media--issues"
        data-open-modal="issues"
        data-index="0"
        aria-label="Open Top 10 Issues"
      ></button>
      <div class="unify-card__body">
        <p class="unify-card__eyebrow">Survey report</p>
        <h2>
          <button type="button" class="unify-card__title-btn" data-open-modal="issues" data-index="0">
            Top 10 Issues
          </button>
        </h2>
        <p class="unify-card__lead">{site.tagline}</p>
        <ol class="unify-card__list">
          {
            issuePreview.map((issue) => (
              <li>
                <span class="unify-card__num">{issue.number}</span>
                <div>
                  <strong>{issue.title}</strong>
                  <p>{issue.shortBlurb}</p>
                </div>
              </li>
            ))
          }
        </ol>
        <div class="unify-card__actions">
          <button type="button" class="unify-card__cta" data-open-modal="issues" data-index="0">
            See more
          </button>
          <a class="unify-card__readmore" href="/issues">Read more →</a>
        </div>
      </div>
    </article>
  </div>
</section>

<section class="section unify unify--alt" id="schools-home">
  <div class="container">
    <article class="unify-card">
      <button
        type="button"
        class="unify-card__media unify-card__media--schools"
        data-open-modal="schools"
        data-index="0"
        aria-label="Open what schools are doing"
      ></button>
      <div class="unify-card__body">
        <p class="unify-card__eyebrow">Campus practice</p>
        <h2>
          <button type="button" class="unify-card__title-btn" data-open-modal="schools" data-index="0">
            What schools are doing
          </button>
        </h2>
        <p class="unify-card__lead">A few approaches already in use across WNC.</p>
        <ol class="unify-card__list">
          {
            practicePreview.map((practice, index) => (
              <li>
                <span class="unify-card__num">{index + 1}</span>
                <div>
                  <strong>{practice.title}</strong>
                  <p>{practice.summary}</p>
                </div>
              </li>
            ))
          }
        </ol>
        <div class="unify-card__actions">
          <button type="button" class="unify-card__cta" data-open-modal="schools" data-index="0">
            See more
          </button>
          <a class="unify-card__readmore" href="/schools">Read more →</a>
        </div>
      </div>
    </article>
  </div>
</section>

<dialog class="info-dialog info-dialog--issues" id="issues-dialog" aria-labelledby="issues-dialog-title">
  <div class="info-dialog__panel">
    <header class="info-dialog__banner">
      <div class="info-dialog__banner-copy">
        <p class="info-dialog__kicker">Survey report</p>
        <h2 id="issues-dialog-title">Top 10 Issues</h2>
        <p class="info-dialog__banner-lead">Facing WNC educators · Brain first, then AI.</p>
        <a class="info-dialog__readmore" href="/issues">Read more →</a>
      </div>
      <button type="button" class="info-dialog__close" data-close-dialog aria-label="Close">
        <span aria-hidden="true">×</span>
      </button>
    </header>

    <div class="info-dialog__layout">
      <nav class="info-dialog__nav" aria-label="Issues">
        <p class="info-dialog__nav-label">Browse</p>
        {
          issues.map((issue) => (
            <button type="button" data-show-panel="issues" data-index={issue.number - 1}>
              <span class="info-dialog__nav-num">{issue.number}</span>
              <span class="info-dialog__nav-text">
                <span class="info-dialog__nav-title">{issue.title}</span>
                <span class="info-dialog__nav-meta">{issueCategoryLabel[issue.category]}</span>
              </span>
            </button>
          ))
        }
      </nav>

      <div class="info-dialog__stage">
        {
          issues.map((issue, index) => (
            <article
              class="info-dialog__detail"
              data-panel="issues"
              data-index={index}
              hidden={index !== 0}
            >
              <div class="info-dialog__detail-top">
                <span class="info-dialog__watermark" aria-hidden="true">
                  {String(issue.number).padStart(2, "0")}
                </span>
                <p class="info-dialog__num">Issue {issue.number} of 10</p>
                <span class="info-dialog__chip">{issueCategoryLabel[issue.category]}</span>
              </div>
              <h3>{issue.title}</h3>
              <p class="info-dialog__lede">{issue.shortBlurb}</p>
              <div class="info-dialog__prose">
                {issue.body.map((paragraph) => (
                  <p>{paragraph}</p>
                ))}
              </div>
              <div class="info-dialog__footer">
                <div class="info-dialog__stepper">
                  <button
                    type="button"
                    data-step="prev"
                    data-kind="issues"
                    disabled={index === 0}
                  >
                    ← Prev
                  </button>
                  <button
                    type="button"
                    data-step="next"
                    data-kind="issues"
                    disabled={index === issues.length - 1}
                  >
                    Next →
                  </button>
                </div>
                <a class="info-dialog__more" href={`/issues/${issue.slug}`}>Full issue page →</a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</dialog>

<dialog class="info-dialog info-dialog--schools" id="schools-dialog" aria-labelledby="schools-dialog-title">
  <div class="info-dialog__panel">
    <header class="info-dialog__banner">
      <div class="info-dialog__banner-copy">
        <p class="info-dialog__kicker">Campus practice</p>
        <h2 id="schools-dialog-title">What schools are doing</h2>
        <p class="info-dialog__banner-lead">Approaches already in use across WNC campuses.</p>
        <a class="info-dialog__readmore" href="/schools">Read more →</a>
      </div>
      <button type="button" class="info-dialog__close" data-close-dialog aria-label="Close">
        <span aria-hidden="true">×</span>
      </button>
    </header>

    <div class="info-dialog__layout">
      <nav class="info-dialog__nav" aria-label="Campus practices">
        <p class="info-dialog__nav-label">Practices</p>
        {
          schoolPractices.map((practice, index) => (
            <button type="button" data-show-panel="schools" data-index={index}>
              <span class="info-dialog__nav-num">{index + 1}</span>
              <span class="info-dialog__nav-text">
                <span class="info-dialog__nav-title">{practice.title}</span>
                <span class="info-dialog__nav-meta">{practice.institution}</span>
              </span>
            </button>
          ))
        }
      </nav>

      <div class="info-dialog__stage">
        {
          schoolPractices.map((practice, index) => (
            <article
              class="info-dialog__detail"
              data-panel="schools"
              data-index={index}
              hidden={index !== 0}
            >
              <div class="info-dialog__detail-top">
                <span class="info-dialog__watermark" aria-hidden="true">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <p class="info-dialog__num">{practice.institution}</p>
              </div>
              <h3>{practice.title}</h3>
              <p class="info-dialog__lede">{practice.summary}</p>
              <div class="info-dialog__tags">
                {practice.tags.map((tag) => (
                  <span>{tag}</span>
                ))}
              </div>
              <div class="info-dialog__prose">
                {practice.detail.map((paragraph) => (
                  <p>{paragraph}</p>
                ))}
              </div>
              <div class="info-dialog__footer">
                <div class="info-dialog__stepper">
                  <button
                    type="button"
                    data-step="prev"
                    data-kind="schools"
                    disabled={index === 0}
                  >
                    ← Prev
                  </button>
                  <button
                    type="button"
                    data-step="next"
                    data-kind="schools"
                    disabled={index === schoolPractices.length - 1}
                  >
                    Next →
                  </button>
                </div>
                {practice.link ? (
                  <a
                    class="info-dialog__more"
                    href={practice.link.href}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {practice.link.label} →
                  </a>
                ) : (
                  <a class="info-dialog__more" href="/schools">
                    All campus practices →
                  </a>
                )}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</dialog>

<script>
  function setupDialog(dialogId: string, kind: string) {
    const dialog = document.getElementById(dialogId) as HTMLDialogElement | null;
    if (!dialog) return;
    const total = dialog.querySelectorAll(`[data-show-panel="${kind}"]`).length;
    let current = 0;

    function showPanel(index: number) {
      if (!dialog) return;
      current = Math.max(0, Math.min(total - 1, index));
      dialog.querySelectorAll(`[data-panel="${kind}"]`).forEach((panel) => {
        const el = panel as HTMLElement;
        const active = Number(el.dataset.index) === current;
        el.hidden = !active;
        if (active) {
          el.classList.remove("is-enter");
          void el.offsetWidth;
          el.classList.add("is-enter");
        }
      });
      dialog.querySelectorAll(`[data-show-panel="${kind}"]`).forEach((btn) => {
        const el = btn as HTMLElement;
        el.classList.toggle("is-active", Number(el.dataset.index) === current);
      });
      const activeNav = dialog.querySelector<HTMLElement>(
        `[data-show-panel="${kind}"].is-active`,
      );
      activeNav?.scrollIntoView({ block: "nearest", inline: "nearest" });
    }

    document.querySelectorAll(`[data-open-modal="${kind}"]`).forEach((btn) => {
      btn.addEventListener("click", () => {
        showPanel(Number((btn as HTMLElement).dataset.index || 0));
        dialog.showModal();
      });
    });

    dialog.querySelectorAll(`[data-show-panel="${kind}"]`).forEach((btn) => {
      btn.addEventListener("click", () => {
        showPanel(Number((btn as HTMLElement).dataset.index || 0));
      });
    });

    dialog.querySelectorAll(`[data-kind="${kind}"][data-step]`).forEach((btn) => {
      btn.addEventListener("click", () => {
        const step = (btn as HTMLElement).dataset.step;
        showPanel(current + (step === "next" ? 1 : -1));
      });
    });

    dialog.querySelectorAll("[data-close-dialog]").forEach((btn) => {
      btn.addEventListener("click", () => dialog.close());
    });

    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });

    dialog.addEventListener("keydown", (event) => {
      if (!dialog.open) return;
      if (event.key === "ArrowRight") {
        event.preventDefault();
        showPanel(current + 1);
      }
      if (event.key === "ArrowLeft") {
        event.preventDefault();
        showPanel(current - 1);
      }
    });

    showPanel(0);
  }

  setupDialog("issues-dialog", "issues");
  setupDialog("schools-dialog", "schools");
</script>

<style>
  .unify {
    background: var(--cream);
    padding-block: clamp(1.75rem, 3.5vw, 2.5rem);
  }

  .unify--alt {
    background: color-mix(in srgb, var(--green-light) 18%, var(--cream));
  }

  .unify-card {
    display: grid;
    grid-template-columns: minmax(10rem, 0.85fr) minmax(0, 1.45fr);
    gap: clamp(1.25rem, 3vw, 2rem);
    align-items: center;
    max-width: 54rem;
    margin-inline: auto;
    background: transparent;
    border: 0;
  }

  .unify-card__media {
    border: 0;
    padding: 0;
    cursor: pointer;
    border-radius: var(--radius-lg);
    overflow: hidden;
    min-height: 17rem;
    position: relative;
    display: block;
    width: 100%;
    transition: transform 0.25s ease, filter 0.25s ease;
    background-color: color-mix(in srgb, var(--ink) 35%, var(--green));
    background-image:
      linear-gradient(
        160deg,
        color-mix(in srgb, var(--ink) 42%, transparent),
        color-mix(in srgb, var(--ink) 18%, transparent) 55%,
        color-mix(in srgb, var(--cream) 12%, transparent)
      ),
      url("/images/wnc-mountains/ridge-mist.webp");
    background-size: cover;
    background-position: center 40%;
  }

  .unify-card__media--schools {
    background-image:
      linear-gradient(
        160deg,
        color-mix(in srgb, var(--ink) 40%, transparent),
        color-mix(in srgb, var(--ink) 16%, transparent) 55%,
        color-mix(in srgb, var(--cream) 10%, transparent)
      ),
      url("/images/wnc-mountains/blue-ridge.webp");
    background-position: center 35%;
  }

  .unify-card__media:hover,
  .unify-card__media:focus-visible {
    transform: scale(1.015);
    filter: saturate(1.08);
    outline: none;
  }

  .unify-card__media:focus-visible {
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--purple) 45%, transparent);
  }

  .unify-card__media::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      transparent 45%,
      color-mix(in srgb, var(--cream) 28%, transparent)
    );
    pointer-events: none;
  }

  .unify--alt .unify-card__media::after {
    background: linear-gradient(
      90deg,
      transparent 45%,
      color-mix(in srgb, var(--green-light) 18%, var(--cream) 30%, transparent)
    );
  }

  .unify-card__body {
    display: grid;
    align-content: start;
    gap: 0.45rem;
    padding: 0.25rem 0;
    background: transparent;
  }

  .unify-card__eyebrow {
    margin: 0;
    color: var(--purple);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 700;
  }

  .unify--alt .unify-card__eyebrow {
    color: var(--blue);
  }

  .unify-card h2 {
    margin: 0;
    font-size: clamp(1.55rem, 3vw, 1.9rem);
  }

  .unify-card__title-btn {
    border: 0;
    background: transparent;
    padding: 0;
    margin: 0;
    font: inherit;
    color: inherit;
    text-align: left;
    cursor: pointer;
  }

  .unify-card__title-btn:hover,
  .unify-card__title-btn:focus-visible {
    color: var(--purple);
    outline: none;
  }

  .unify--alt .unify-card__title-btn:hover,
  .unify--alt .unify-card__title-btn:focus-visible {
    color: var(--blue);
  }

  .unify-card__lead {
    margin: 0 0 0.35rem;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .unify-card__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.7rem;
  }

  .unify-card__list li {
    display: grid;
    grid-template-columns: 1.4rem minmax(0, 1fr);
    gap: 0.55rem;
  }

  .unify-card__num {
    color: var(--green);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    padding-top: 0.1rem;
  }

  .unify--alt .unify-card__num {
    color: var(--blue);
  }

  .unify-card__list strong {
    display: block;
    font-family: var(--font-display);
    font-size: 1.02rem;
    font-weight: 600;
    line-height: 1.25;
    margin-bottom: 0.15rem;
  }

  .unify-card__list p {
    margin: 0;
    color: var(--muted);
    font-size: 0.88rem;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .unify-card__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    align-items: center;
    gap: 0.65rem;
    margin-top: 0.55rem;
  }

  .unify-card__cta {
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--purple);
    color: var(--white);
    font: inherit;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.55rem 1.1rem;
    cursor: pointer;
    transition: transform 0.2s ease, background-color 0.2s ease;
  }

  .unify--alt .unify-card__cta {
    background: var(--blue);
  }

  .unify-card__cta:hover {
    transform: scale(1.03);
    filter: brightness(0.95);
  }

  .unify-card__readmore {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.85rem;
    padding: 0.65rem 1.35rem;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--purple) 12%, white);
    color: var(--purple);
    font-size: 1.05rem;
    font-weight: 700;
    text-decoration: none;
    transition: transform 0.2s ease, background-color 0.2s ease, color 0.2s ease;
  }

  .unify--alt .unify-card__readmore {
    background: color-mix(in srgb, var(--blue) 14%, white);
    color: var(--blue);
  }

  .unify-card__readmore:hover {
    transform: scale(1.03);
    background: var(--purple);
    color: var(--white);
  }

  .unify--alt .unify-card__readmore:hover {
    background: var(--blue);
    color: var(--white);
  }

  .info-dialog {
    --dialog-accent: var(--green);
    --dialog-accent-soft: var(--purple);
    --dialog-banner-image: url("/images/wnc-mountains/ridge-mist.webp");
    border: 0;
    padding: 0;
    background: transparent;
    max-width: min(100vw - 1.5rem, 64rem);
    width: 100%;
  }

  .info-dialog::backdrop {
    background:
      radial-gradient(circle at 20% 10%, color-mix(in srgb, var(--dialog-accent-soft) 28%, transparent), transparent 42%),
      color-mix(in srgb, var(--ink) 62%, transparent);
    backdrop-filter: blur(4px);
  }

  .info-dialog__panel {
    background: var(--cream);
    border-radius: 1.5rem;
    overflow: hidden;
    max-height: min(90vh, 48rem);
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    box-shadow:
      0 28px 70px color-mix(in srgb, #000 30%, transparent),
      0 0 0 1px color-mix(in srgb, var(--white) 35%, transparent);
    animation: infoPop 0.38s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  @keyframes infoPop {
    from {
      opacity: 0;
      transform: translateY(1.1rem) scale(0.97);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .info-dialog__banner {
    position: relative;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: start;
    padding: 1.35rem 1.4rem 1.25rem;
    color: var(--white);
    isolation: isolate;
    overflow: hidden;
    background-color: color-mix(in srgb, var(--ink) 55%, var(--dialog-accent));
    background-image:
      linear-gradient(
        145deg,
        color-mix(in srgb, var(--ink) 68%, transparent),
        color-mix(in srgb, var(--ink) 42%, transparent) 42%,
        color-mix(in srgb, var(--dialog-accent) 28%, transparent) 72%,
        color-mix(in srgb, var(--ink) 38%, transparent)
      ),
      var(--dialog-banner-image);
    background-size: cover;
    background-position: center 38%;
  }

  .info-dialog--issues {
    --dialog-accent: var(--green);
    --dialog-accent-soft: var(--purple);
    --dialog-banner-image: url("/images/wnc-mountains/ridge-mist.webp");
  }

  .info-dialog--schools {
    --dialog-accent: var(--blue);
    --dialog-accent-soft: var(--green);
    --dialog-banner-image: url("/images/wnc-mountains/blue-ridge.webp");
  }

  .info-dialog__banner-copy {
    min-width: 0;
  }

  .info-dialog__kicker {
    margin: 0 0 0.3rem;
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 700;
    opacity: 0.9;
  }

  .info-dialog__banner h2 {
    margin: 0;
    font-size: clamp(1.55rem, 3vw, 2rem);
    color: var(--white);
  }

  .info-dialog__banner-lead {
    margin: 0.4rem 0 0;
    font-size: 0.95rem;
    opacity: 0.88;
    max-width: 36rem;
  }

  .info-dialog__readmore {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 0.95rem;
    min-height: 2.9rem;
    padding: 0.7rem 1.45rem;
    border-radius: var(--radius-pill);
    background: var(--white);
    color: var(--ink);
    font-size: 1.08rem;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 8px 20px color-mix(in srgb, #000 12%, transparent);
    transition: transform 0.2s ease, background-color 0.2s ease;
  }

  .info-dialog__readmore:hover {
    transform: scale(1.03);
    background: color-mix(in srgb, var(--green-light) 55%, white);
  }

  .info-dialog__close {
    border: 0;
    flex: 0 0 auto;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--white) 18%, transparent);
    color: var(--white);
    font: inherit;
    font-size: 1.45rem;
    line-height: 1;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .info-dialog__close:hover {
    background: color-mix(in srgb, var(--white) 32%, transparent);
  }

  .info-dialog__layout {
    display: grid;
    grid-template-columns: minmax(13rem, 16.5rem) minmax(0, 1fr);
    min-height: 0;
    max-height: 100%;
  }

  .info-dialog__nav {
    display: grid;
    gap: 0.25rem;
    align-content: start;
    padding: 1rem 0.75rem 1rem 0.9rem;
    border-right: 1px solid color-mix(in srgb, var(--purple) 12%, transparent);
    background: color-mix(in srgb, var(--white) 55%, var(--cream));
    overflow: auto;
    max-height: min(68vh, 36rem);
  }

  .info-dialog__nav-label {
    margin: 0 0.4rem 0.45rem;
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--muted);
  }

  .info-dialog__nav button {
    text-align: left;
    border: 0;
    background: transparent;
    border-radius: 0.85rem;
    padding: 0.55rem 0.55rem;
    cursor: pointer;
    color: var(--muted);
    font: inherit;
    display: grid;
    grid-template-columns: 1.7rem minmax(0, 1fr);
    gap: 0.5rem;
    align-items: start;
    transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }

  .info-dialog__nav-num {
    width: 1.7rem;
    height: 1.7rem;
