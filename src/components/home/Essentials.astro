---
import SectionHeader from "../ui/SectionHeader.astro";
import EssentialsHub from "./EssentialsHub";
import { issues } from "../../content/issues";
import { schoolPractices } from "../../content/schools";

const hubIssues = issues.map(({ number, slug, title, shortBlurb, body }) => ({
  number,
  slug,
  title,
  shortBlurb,
  body,
}));

const hubPractices = schoolPractices.map(
  ({ id, institution, title, summary, detail, tags, link }) => ({
    id,
    institution,
    title,
    summary,
    detail,
    tags: [...tags],
    link,
  }),
);
---

<section class="section essentials">
  <div class="container">
    <div data-reveal>
      <SectionHeader eyebrow="From the region" title="The issues, and what campuses are doing" align="center">
        <p>
          The survey named the pressure points. Campuses are already responding—often without much
          institutional backing. Open either column for the full set.
        </p>
      </SectionHeader>
    </div>

    <div data-reveal data-reveal-delay="0.06" data-reveal-y="28">
      <EssentialsHub client:load issues={hubIssues} practices={hubPractices} />
    </div>
  </div>
</section>

<style>
  .essentials {
    background: var(--white);
  }
</style>
