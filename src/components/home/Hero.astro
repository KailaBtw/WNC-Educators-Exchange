---
import Button from "../ui/Button.astro";
import { site } from "../../content/site";
---

<section class="hero">
  <div class="hero__media" aria-hidden="true"></div>
  <div class="container hero__content" data-reveal data-reveal-y="24">
    <p class="hero__brand">{site.name}</p>
    <h1>AI for educators, grounded in Western North Carolina.</h1>
    <p class="hero__support">
      AI is already in WNC classrooms. This site collects what regional educators reported, what
      campuses are trying, and how to register for the November 17 summit.
    </p>
    <div class="hero__actions" data-reveal data-reveal-delay="0.1" data-reveal-y="16">
      <Button href={site.registerUrl} variant="light" external>Register for Nov 17</Button>
      <Button href="/events" variant="secondary">Explore events</Button>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: clamp(28rem, 62vh, 36rem);
    display: grid;
    align-items: center;
    overflow: hidden;
    color: var(--white);
  }

  .hero__media {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        120deg,
        color-mix(in srgb, var(--ink) 78%, transparent) 12%,
        color-mix(in srgb, var(--purple) 45%, transparent) 55%,
        color-mix(in srgb, var(--green) 35%, transparent)
      ),
      radial-gradient(circle at 70% 30%, var(--green-light), transparent 45%),
      url("/images/hero/hero-bg.svg") center / cover no-repeat;
  }

  .hero__content {
    position: relative;
    z-index: 1;
    padding-block: clamp(2.75rem, 6vh, 4rem);
    max-width: 52rem;
    margin-inline: auto;
    text-align: center;
    display: grid;
    justify-items: center;
  }

  .hero__brand {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.5vw, 1.65rem);
    margin-bottom: 0.65rem;
    color: var(--green-light);
  }

  .hero h1 {
    font-size: clamp(2.1rem, 4.8vw, 3.15rem);
    max-width: 24ch;
    margin-bottom: 0.85rem;
  }

  .hero__support {
    max-width: 38rem;
    color: color-mix(in srgb, var(--white) 90%, transparent);
    margin-bottom: 1.35rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
  }

  .hero__actions :global(.btn--secondary) {
    color: var(--white);
    box-shadow: inset 0 0 0 1.5px color-mix(in srgb, var(--white) 70%, transparent);
  }

  .hero__actions :global(.btn--light) {
    box-shadow: 0 8px 24px color-mix(in srgb, #000 22%, transparent);
  }
</style>
