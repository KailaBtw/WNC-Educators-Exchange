---
import Button from "../ui/Button.astro";
import { site } from "../../content/site";
---

<section class="hero">
  <div class="hero__media" aria-hidden="true"></div>
  <div class="container hero__content fade-up">
    <p class="hero__brand">{site.name}</p>
    <h1>AI for educators, grounded in Western North Carolina.</h1>
    <p class="hero__support">
      Celebrating what came before, sharing what we learned, and inviting you to our November 17
      gathering.
    </p>
    <div class="hero__actions">
      <Button href={site.registerUrl} external>Register for Nov 17</Button>
      <Button href="/events" variant="secondary">Explore events</Button>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: calc(100vh - var(--header-h));
    display: grid;
    align-items: end;
    overflow: hidden;
    color: var(--white);
  }

  .hero__media {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        120deg,
        color-mix(in srgb, var(--ink) 78%, transparent) 12%,
        color-mix(in srgb, var(--purple) 45%, transparent) 55%,
        color-mix(in srgb, var(--green) 35%, transparent)
      ),
      radial-gradient(circle at 70% 30%, var(--green-light), transparent 45%),
      url("/images/hero/hero-bg.svg") center / cover no-repeat;
  }

  .hero__content {
    position: relative;
    z-index: 1;
    padding-block: clamp(4rem, 12vh, 7rem) clamp(3.5rem, 10vh, 6rem);
    max-width: 42rem;
    margin-inline: 0 auto 0;
    width: min(100% - 2.5rem, 42rem);
  }

  .hero__brand {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 3vw, 1.85rem);
    margin-bottom: 0.85rem;
    color: var(--green-light);
  }

  .hero h1 {
    font-size: clamp(2.4rem, 6vw, 3.6rem);
    max-width: 14ch;
    margin-bottom: 1rem;
  }

  .hero__support {
    max-width: 34rem;
    color: color-mix(in srgb, var(--white) 90%, transparent);
    margin-bottom: 1.6rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .hero__actions :global(.btn--secondary) {
    color: var(--white);
    box-shadow: inset 0 0 0 1.5px color-mix(in srgb, var(--white) 55%, transparent);
  }
</style>
