---
import Button from "../ui/Button.astro";
import { site } from "../../content/site";
import { routes } from "../../config/site";
import { cssUrl } from "../../lib/paths";
---

<section class="hero">
  <div class="hero__media" aria-hidden="true" style={`--hero-image: ${cssUrl("heroUnca")}`} />
  <a
    class="hero__place"
    href="https://www.unca.edu/"
    target="_blank"
    rel="noopener noreferrer"
  >
    UNCA campus
  </a>
  <span class="hero__org">Part of the “Brain Hub” org</span>
  <div class="container hero__content" data-reveal data-reveal-y="24">
    <p class="hero__brand">{site.name}</p>
    <h1>AI for educators, grounded in Western North Carolina.</h1>
    <p class="hero__support">
      AI is already in WNC classrooms. This site collects what regional educators reported, what
      campuses are trying, and how to join the November 13 Educators Exchange at Mars Hill University.
    </p>
    <div class="hero__actions">
      <Button href={site.registerUrl} variant="light" external>Register for Nov 13</Button>
      <Button href={routes.november} variant="secondary">Event details</Button>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: clamp(28rem, 62vh, 36rem);
    display: grid;
    align-items: center;
    overflow: hidden;
    color: var(--white);
  }

  .hero__media {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--ink) 62%, transparent) 8%,
        color-mix(in srgb, var(--ink) 48%, transparent) 48%,
        color-mix(in srgb, var(--ink) 68%, transparent) 100%
      ),
      var(--hero-image) center / cover no-repeat;
  }

  .hero__place {
    position: absolute;
    left: var(--page-gutter);
    bottom: 1rem;
    z-index: 2;
    padding: 0.28rem 0.65rem;
    border-radius: 0.45rem;
    background: color-mix(in srgb, var(--ink) 55%, transparent);
    color: color-mix(in srgb, var(--white) 92%, transparent);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .hero__place:hover,
  .hero__place:focus-visible {
    background: color-mix(in srgb, var(--ink) 72%, transparent);
    color: var(--white);
    outline: none;
  }

  .hero__place:focus-visible {
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--white) 70%, transparent);
  }

  .hero__org {
    position: absolute;
    right: var(--page-gutter);
    bottom: 1rem;
    z-index: 2;
    padding: 0.28rem 0.65rem;
    border-radius: 0.45rem;
    background: color-mix(in srgb, var(--ink) 55%, transparent);
    color: color-mix(in srgb, var(--white) 92%, transparent);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    max-width: min(16rem, 46vw);
    text-align: right;
  }

  .hero__content {
    position: relative;
    z-index: 1;
    padding-block: clamp(2.75rem, 6vh, 4rem);
    max-width: 52rem;
    margin-inline: auto;
    text-align: center;
    display: grid;
    justify-items: center;
  }

  .hero__brand {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.5vw, 1.65rem);
    margin-bottom: 0.65rem;
    color: var(--green-light);
  }

  .hero h1 {
    font-size: clamp(2.1rem, 4.8vw, 3.15rem);
    max-width: 24ch;
    margin-bottom: 0.85rem;
  }

  .hero__support {
    max-width: 38rem;
    color: color-mix(in srgb, var(--white) 90%, transparent);
    margin-bottom: 1.35rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
  }

  .hero__actions :global(.btn--secondary) {
    color: var(--white);
    box-shadow: inset 0 0 0 1.5px color-mix(in srgb, var(--white) 70%, transparent);
  }

  .hero__actions :global(.btn--light) {
    box-shadow: 0 8px 24px color-mix(in srgb, #000 22%, transparent);
  }
</style>
