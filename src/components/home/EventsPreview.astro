---
import SectionHeader from "../ui/SectionHeader.astro";
import ScheduleTimeline from "../events/ScheduleTimeline.astro";
import PastEventCard from "../events/PastEventCard.astro";
import PastEventDialogs from "../events/PastEventDialogs.astro";
import Button from "../ui/Button.astro";
import { events } from "../../content/events";
import { routes } from "../../config/site";

const upcoming = events.find((e) => e.status === "upcoming");
const past = events.filter((e) => e.status === "past");
---

<section class="section events-home" id="events">
  <div class="container">
    <div data-reveal>
      <SectionHeader eyebrow="Events" title="Next gathering">
        <p>Friday, November 13 · Mars Hill University · Enrollment limited.</p>
      </SectionHeader>
    </div>

    {
      upcoming && (
        <article class="events-home__featured" data-reveal data-reveal-y="28">
          <header class="events-home__featured-head">
            <p class="events-home__status">Upcoming · {upcoming.category}</p>
            <h3>{upcoming.title}</h3>
            <p class="events-home__date">{upcoming.dateLabel}</p>
            <ul class="events-home__facts" aria-label="Event details">
              {
                upcoming.hoursLabel && (
                  <li>{upcoming.hoursLabel}</li>
                )
              }
              {
                upcoming.location && (
                  <li>{upcoming.location}</li>
                )
              }
              {
                upcoming.costLabel && (
                  <li>{upcoming.costLabel}</li>
                )
              }
            </ul>
            <p class="events-home__summary">{upcoming.summary}</p>
          </header>

          {
            upcoming.sessions?.length ? (
              <div class="events-home__schedule">
                <p class="events-home__schedule-label">Day at a glance</p>
                <ScheduleTimeline
                  sessions={upcoming.sessions}
                  idPrefix="home-nov"
                  size="compact"
                  brief
                  showDetail={false}
                />
              </div>
            ) : null
          }

          <footer class="events-home__actions">
            <Button href={routes.events}>Full schedule & details</Button>
            {
              upcoming.registerUrl && (
                <Button href={upcoming.registerUrl} variant="secondary" external>
                  Register for Nov 13
                </Button>
              )
            }
          </footer>
        </article>
      )
    }

    {
      past.length > 0 && (
        <div class="events-home__past" data-reveal data-reveal-delay="0.08" data-reveal-y="24">
          <p class="events-home__past-heading">Previous gatherings</p>
          <div class="events-home__past-grid">
            {past.map((event) => (
              <PastEventCard event={event} />
            ))}
          </div>
        </div>
      )
    }
  </div>
</section>

<PastEventDialogs events={events} />

<style>
  .events-home__featured {
    display: grid;
    gap: 1rem;
    margin-top: 0.35rem;
    padding: clamp(1rem, 2.5vw, 1.4rem);
    border-radius: var(--radius-lg);
    background:
      linear-gradient(
        160deg,
        color-mix(in srgb, var(--green-light) 28%, white),
        color-mix(in srgb, var(--cream) 88%, white)
      );
    border: 1px solid color-mix(in srgb, var(--green) 14%, transparent);
  }

  .events-home__status {
    margin: 0 0 0.3rem;
    color: var(--green-strong);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .events-home__featured-head h3 {
    margin: 0 0 0.45rem;
    font-size: clamp(1.35rem, 2.8vw, 1.85rem);
    line-height: 1.2;
    max-width: 28ch;
  }

  .events-home__date {
    margin: 0 0 0.45rem;
    color: var(--blue);
    font-weight: 700;
    font-size: 1rem;
  }

  .events-home__facts {
    margin: 0 0 0.7rem;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.2rem;
    color: var(--ink);
    font-weight: 600;
    font-size: 0.95rem;
  }

  .events-home__facts li {
    margin: 0;
  }

  .events-home__summary {
    margin: 0;
    color: var(--muted);
    max-width: 40rem;
    font-size: 0.95rem;
    line-height: 1.45;
  }

  .events-home__schedule {
    padding: 0.75rem 0 0;
    border-top: 1px solid color-mix(in srgb, var(--green) 16%, transparent);
  }

  .events-home__schedule-label {
    margin: 0 0 0.4rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--green);
  }

  .events-home__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    padding-top: 0.15rem;
    border-top: 1px solid color-mix(in srgb, var(--green) 12%, transparent);
  }

  .events-home__past {
    margin-top: clamp(1.5rem, 3.5vw, 2.15rem);
  }

  .events-home__past-heading {
    margin: 0 0 0.85rem;
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 2.6vw, 1.65rem);
    font-weight: 600;
    line-height: 1.2;
    color: var(--ink);
  }

  .events-home__past-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 2.5vw, 1.5rem);
  }

  @media (max-width: 720px) {
    .events-home__past-grid {
      grid-template-columns: 1fr;
    }

    .events-home__actions {
      flex-direction: column;
      align-items: stretch;
    }

    .events-home__actions :global(.btn) {
      width: 100%;
      justify-content: center;
    }
  }
</style>
