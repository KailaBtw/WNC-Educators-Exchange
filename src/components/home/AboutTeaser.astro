---
import StatRow from "../ui/StatRow.astro";
import Button from "../ui/Button.astro";
import { site, surveyAttribution } from "../../content/site";
import { stats } from "../../content/stats";
import { assets, routes } from "../../config/site";
import { asset, withBase } from "../../lib/paths";
---

<section class="section about-teaser">
  <div class="container about-teaser__grid">
    <div class="about-teaser__logos" data-reveal data-reveal-y="28">
      <a class="about-teaser__logo about-teaser__logo--brain" href={withBase(routes.brainHub)}>
        <img
          src={asset(assets.logoBrainHub)}
          alt={`${site.brainHubName} logo`}
          width="220"
          height="220"
        />
      </a>
      <div class="about-teaser__logo about-teaser__logo--sky">
        <img
          src={asset(assets.logoLandOfSky)}
          alt={`${site.org} logo`}
          width="280"
          height="110"
        />
      </div>
    </div>
    <div class="about-teaser__copy" data-reveal data-reveal-delay="0.1" data-reveal-y="32">
      <p class="eyebrow">About</p>
      <h2>Educators Exchanging Ideas about A.I.</h2>
      <div class="prose muted">
        <p>
          The WNC Educators Exchange grew out of the Land of Sky AI Summits and sits inside the 2026
          Brain Hub initiatives—so educators across the region have a place to meet peers, exchange
          ideas, and learn from one another.
        </p>
        <p>
          {surveyAttribution.blurb}
        </p>
      </div>
      <StatRow stats={stats.aboutTeaser} />
      <div class="about-teaser__actions">
        <Button href={routes.about} variant="quiet">About the Exchange</Button>
      </div>
    </div>
  </div>
</section>

<style>
  .about-teaser__grid {
    display: grid;
    grid-template-columns: minmax(0, 15rem) 1fr;
    gap: clamp(1.5rem, 4vw, 2.75rem);
    align-items: center;
  }

  .about-teaser__logos {
    display: grid;
    gap: 0.85rem;
    justify-items: center;
  }

  .about-teaser__logo {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 0.85rem 1rem;
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--white) 82%, var(--cream));
    border: 1px solid color-mix(in srgb, var(--ink) 8%, transparent);
    text-decoration: none;
  }

  .about-teaser__logo--brain {
    max-width: 10.5rem;
  }

  .about-teaser__logo--sky {
    max-width: 14rem;
  }

  .about-teaser__logo img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: contain;
  }

  .about-teaser__copy h2 {
    font-size: clamp(1.85rem, 3.2vw, 2.4rem);
    margin: 0.35rem 0 0.75rem;
  }

  .about-teaser__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    align-items: center;
    margin-top: 1rem;
  }

  @media (max-width: 900px) {
    .about-teaser__grid {
      grid-template-columns: 1fr;
      justify-items: center;
    }

    .about-teaser__logos {
      grid-template-columns: auto auto;
      align-items: center;
      width: 100%;
      max-width: 28rem;
    }

    .about-teaser__copy {
      justify-self: stretch;
    }
  }
</style>
