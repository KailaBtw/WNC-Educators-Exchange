---
import StatRow from "../ui/StatRow.astro";
import Button from "../ui/Button.astro";
import { stats } from "../../content/stats";
---

<section class="section about-teaser">
  <div class="container about-teaser__grid">
    <div class="about-teaser__image" aria-hidden="true" data-reveal data-reveal-y="40"></div>
    <div class="about-teaser__copy" data-reveal data-reveal-delay="0.1" data-reveal-y="32">
      <p class="eyebrow">About</p>
      <h2>Why this exchange exists</h2>
      <div class="prose muted">
        <p>
          Artificial intelligence has arrived in WNC classrooms whether educators are ready for it or
          not. The regional educator survey made that plain: most AI-active faculty are already using
          the tools, many say policy is behind or missing, and loss of critical thinking tops the list
          of concerns.
        </p>
        <p>
          The Exchange is the regional infrastructure for that conversation—summits, shared practice,
          and a written account of the ten issues that keep showing up. Brain first, then AI.
        </p>
      </div>
      <StatRow stats={stats.aboutTeaser} />
      <div class="about-teaser__actions">
        <Button href="/about" variant="quiet">About the Exchange</Button>
        <Button href="/awards" variant="quiet">Faculty we recognize</Button>
      </div>
    </div>
  </div>
</section>

<style>
  .about-teaser__grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(1.5rem, 4vw, 2.75rem);
    align-items: center;
  }

  .about-teaser__image {
    border-radius: var(--radius-lg);
    aspect-ratio: 4 / 5;
    min-height: 18rem;
    background:
      linear-gradient(
        160deg,
        color-mix(in srgb, var(--green) 55%, transparent),
        color-mix(in srgb, var(--purple) 65%, transparent)
      ),
      url("/images/about/story-1.svg") center / cover no-repeat;
  }

  .about-teaser__copy h2 {
    font-size: clamp(1.85rem, 3.2vw, 2.4rem);
    margin: 0.35rem 0 0.75rem;
  }

  .about-teaser__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    align-items: center;
    margin-top: 1rem;
  }

  @media (max-width: 900px) {
    .about-teaser__grid {
      grid-template-columns: 1fr;
    }

    .about-teaser__image {
      aspect-ratio: 16 / 10;
      min-height: 12rem;
    }
  }
</style>
