---
import SectionHeader from "../ui/SectionHeader.astro";
import Button from "../ui/Button.astro";
import { pastAwardsIntro, awardees, awardProfilePath } from "../../content/awards";
import { routes } from "../../config/site";
import { withBase } from "../../lib/paths";

const featured = awardees;
const accents = ["var(--purple)", "var(--blue)", "var(--green)"] as const;
---

<section class="section awards-teaser" id="awards">
  <div class="container">
    <div data-reveal>
      <SectionHeader eyebrow={pastAwardsIntro.eyebrow} title={pastAwardsIntro.title} align="center">
        <p>
          WNC faculty recognized for how they use AI with students and on their campuses.
        </p>
      </SectionHeader>
    </div>

    <div class="awards-teaser__rail">
      {
        featured.map((person, index) => (
          <a
            class="awards-teaser__card"
            href={withBase(awardProfilePath(person.id))}
            data-reveal
            data-reveal-delay={String(0.04 * index)}
            data-reveal-y="20"
            style={`--accent: ${accents[index % accents.length]}`}
          >
            <span class="awards-teaser__media">
              <img src={person.image} alt="" width="120" height="120" loading="lazy" />
            </span>
            <span class="awards-teaser__body">
              <span class="awards-teaser__name">{person.name}</span>
              <span class="awards-teaser__institution">{person.institution}</span>
            </span>
          </a>
        ))
      }
    </div>

    <div class="awards-teaser__cta" data-reveal data-reveal-delay="0.12" data-reveal-y="20">
      <Button href={routes.awards}>See all award winners →</Button>
    </div>
  </div>
</section>

<style>
  .awards-teaser {
    background:
      radial-gradient(circle at 12% 20%, color-mix(in srgb, var(--purple) 12%, transparent), transparent 40%),
      radial-gradient(circle at 90% 80%, color-mix(in srgb, var(--green-light) 28%, transparent), transparent 42%),
      var(--cream);
  }

  .awards-teaser__rail {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.65rem;
    max-width: 40rem;
    margin-inline: auto;
  }

  .awards-teaser__card {
    --accent: var(--purple);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.45rem;
    padding: 0.55rem 0.45rem 0.65rem;
    text-align: center;
    text-decoration: none;
    color: inherit;
    border-radius: var(--radius-md, 0.75rem);
    background: color-mix(in srgb, var(--white) 78%, var(--cream));
    border: 1px solid color-mix(in srgb, var(--purple) 10%, transparent);
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .awards-teaser__card:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--accent) 35%, transparent);
  }

  .awards-teaser__media {
    display: block;
    width: 4.25rem;
    height: 4.25rem;
    border-radius: 999px;
    overflow: hidden;
    background: color-mix(in srgb, var(--green-light) 35%, white);
    flex-shrink: 0;
  }

  .awards-teaser__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  .awards-teaser__body {
    display: grid;
    gap: 0.15rem;
    min-width: 0;
  }

  .awards-teaser__name {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .awards-teaser__institution {
    color: var(--muted);
    font-size: 0.72rem;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .awards-teaser__cta {
    display: flex;
    justify-content: center;
    margin-top: 1.25rem;
  }

  @media (min-width: 720px) {
    .awards-teaser__rail {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      max-width: 48rem;
      gap: 0.75rem;
    }

    .awards-teaser__media {
      width: 4.75rem;
      height: 4.75rem;
    }
  }

  @media (min-width: 1024px) {
    .awards-teaser__rail {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      max-width: none;
    }

    .awards-teaser__media {
      width: 4.5rem;
      height: 4.5rem;
    }

    .awards-teaser__name {
      font-size: 0.88rem;
    }
  }
</style>
