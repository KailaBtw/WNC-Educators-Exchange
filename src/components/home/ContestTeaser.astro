---
import SectionHeader from "../ui/SectionHeader.astro";
import Button from "../ui/Button.astro";
import { routes } from "../../config/site";
---

<section class="section contest-teaser" id="contest">
  <div class="container contest-teaser__inner" data-reveal data-reveal-y="28">
    <SectionHeader
      eyebrow="Coming up · Nov 13"
      title="Faculty & student community contest"
      align="center"
    >
      <p>
        Steven Young introduces a faculty–student community contest during the November 13 afternoon
        program at Mars Hill. Official name and entry packet are still forthcoming—teams will use AI
        on projects that help Western North Carolina communities.
      </p>
    </SectionHeader>
    <div class="contest-teaser__actions">
      <Button href={routes.contest}>See contest details</Button>
      <Button href={routes.awards} variant="ghost">Award winners →</Button>
    </div>
  </div>
</section>

<style>
  .contest-teaser {
    background:
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--green-light) 22%, var(--cream)),
        var(--cream)
      );
  }

  .contest-teaser__inner {
    max-width: 42rem;
    margin-inline: auto;
    text-align: center;
  }

  .contest-teaser__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    justify-content: center;
    margin-top: 1.25rem;
  }
</style>
