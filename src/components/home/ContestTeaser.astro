---
import SectionHeader from "../ui/SectionHeader.astro";
import Button from "../ui/Button.astro";
import { routes } from "../../config/site";
---

<section class="section contest-teaser" id="contest">
  <div class="container contest-teaser__inner" data-reveal data-reveal-y="28">
    <SectionHeader
      eyebrow="Coming soon"
      title="Faculty & student community contest"
      align="center"
    >
      <p>
        The WNC Educators Exchange is proud to announce an upcoming contest for faculty and students.
        Contestants will be working on projects focusing on improving local communities with innovative
        AI usage—teachers collaborating with students on community projects. More details will be
        coming soon—stay tuned!
      </p>
    </SectionHeader>
    <div class="contest-teaser__actions">
      <Button href={routes.november}>See the Nov 13 program</Button>
      <Button href={routes.awards} variant="ghost">Faculty we recognize →</Button>
    </div>
  </div>
</section>

<style>
  .contest-teaser {
    background:
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--green-light) 22%, var(--cream)),
        var(--cream)
      );
  }

  .contest-teaser__inner {
    max-width: 42rem;
    margin-inline: auto;
    text-align: center;
  }

  .contest-teaser__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    justify-content: center;
    margin-top: 1.25rem;
  }
</style>
