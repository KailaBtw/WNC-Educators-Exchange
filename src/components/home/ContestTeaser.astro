---
import SectionHeader from "../ui/SectionHeader.astro";
import Button from "../ui/Button.astro";
import { upcomingAwards } from "../../content/awards";
import { routes } from "../../config/site";
---

<section class="section contest-teaser" id="contest">
  <div class="container contest-teaser__inner" data-reveal data-reveal-y="28">
    <SectionHeader
      eyebrow={`${upcomingAwards.eyebrow} · Nov 13`}
      title={upcomingAwards.title}
      align="center"
    >
      <p>
        {upcomingAwards.summary} Three categories. Introduced at the Educators’ Exchange; winners
        showcase at the BrainHub AI Summit on October 1, 2027.
      </p>
    </SectionHeader>
    <div class="contest-teaser__actions">
      <Button href={routes.contest}>Read award guidelines</Button>
      <Button href={routes.awards} variant="ghost">Past Awards →</Button>
    </div>
  </div>
</section>

<style>
  .contest-teaser {
    background:
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--green-light) 22%, var(--cream)),
        var(--cream)
      );
  }

  .contest-teaser__inner {
    max-width: 44rem;
    margin-inline: auto;
    text-align: center;
  }

  .contest-teaser__inner :global(.section-header h2) {
    max-width: 28ch;
  }

  .contest-teaser__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    justify-content: center;
    margin-top: 1.25rem;
  }
</style>
