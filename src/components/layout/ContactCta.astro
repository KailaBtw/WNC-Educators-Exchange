---
import Button from "../ui/Button.astro";
import { site } from "../../content/site";

interface Props {
  eyebrow?: string;
  title?: string;
  description?: string;
}

const {
  eyebrow = "Contact",
  title = "Questions or follow-up?",
  description = "Write about the November 13 Exchange at Mars Hill, the Top 10 Issues report, campus practice, or joining the next gathering.",
} = Astro.props;

const mailtoHref = `mailto:${site.contactEmail}?subject=${encodeURIComponent("WNC Educators’ Exchange inquiry")}`;
---

<section class="contact-cta">
  <div class="container contact-cta__inner" data-reveal data-reveal-y="28">
    <p class="contact-cta__eyebrow">{eyebrow}</p>
    <h2>{title}</h2>
    <p class="contact-cta__desc">{description}</p>
    <div class="contact-cta__actions">
      <Button href={mailtoHref} variant="light">Email Bill with questions</Button>
    </div>
    <p class="contact-cta__hint">
      Or write directly to{" "}
      <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>
    </p>
  </div>
</section>

<style>
  .contact-cta {
    background: var(--purple);
    color: var(--white);
    padding-block: clamp(2.25rem, 5vw, 3.25rem);
  }

  .contact-cta__inner {
    text-align: center;
    display: grid;
    gap: 0.7rem;
    justify-items: center;
    max-width: 44rem;
    margin-inline: auto;
  }

  .contact-cta__eyebrow {
    color: var(--green-light);
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 600;
  }

  .contact-cta h2 {
    font-size: clamp(1.75rem, 4vw, 2.4rem);
    max-width: 16ch;
  }

  .contact-cta__desc {
    max-width: 36rem;
    color: color-mix(in srgb, var(--white) 88%, transparent);
  }

  .contact-cta__actions {
    margin-top: 0.55rem;
  }

  .contact-cta__hint {
    font-size: 0.85rem;
    color: color-mix(in srgb, var(--white) 75%, transparent);
  }

  .contact-cta__hint a {
    color: var(--green-light);
  }
</style>
