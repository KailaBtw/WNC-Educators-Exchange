---
import { site } from "../../content/site";

interface Props {
  eyebrow?: string;
  title?: string;
  description?: string;
}

const {
  eyebrow = "WNC Exchange",
  title = "Questions about the work?",
  description = "Reach out about the November event, the Top 10 Issues report, or regional collaboration. Zero spam—just a direct line to the team.",
} = Astro.props;
---

<section class="contact-cta">
  <div class="container contact-cta__inner fade-up">
    <p class="contact-cta__eyebrow">{eyebrow}</p>
    <h2>{title}</h2>
    <p class="contact-cta__desc">{description}</p>
    <form
      class="contact-cta__form"
      id="contact-mailto-form"
      data-contact-email={site.contactEmail}
    >
      <label class="sr-only" for="cta-email">Email</label>
      <input
        id="cta-email"
        name="email"
        type="email"
        required
        placeholder="your.email@college.edu"
        autocomplete="email"
      />
      <label class="sr-only" for="cta-message">Message</label>
      <input
        id="cta-message"
        name="message"
        type="text"
        required
        placeholder="Your question or note"
      />
      <button type="submit">Contact Us</button>
    </form>
    <p class="contact-cta__hint">
      Opens your email app to <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>
    </p>
  </div>
</section>

<script>
  const form = document.getElementById("contact-mailto-form");
  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    const target = form as HTMLFormElement;
    const to = target.dataset.contactEmail || "contact@wncexchange.com";
    const data = new FormData(target);
    const email = String(data.get("email") || "").trim();
    const message = String(data.get("message") || "").trim();
    const subject = encodeURIComponent("WNC Educators Exchange inquiry");
    const body = encodeURIComponent(`From: ${email}\n\n${message}`);
    window.location.href = `mailto:${to}?subject=${subject}&body=${body}`;
  });
</script>

<style>
  .contact-cta {
    background: var(--purple);
    color: var(--white);
    padding-block: clamp(3.5rem, 8vw, 5.5rem);
  }

  .contact-cta__inner {
    text-align: center;
    display: grid;
    gap: 0.9rem;
    justify-items: center;
  }

  .contact-cta__eyebrow {
    color: var(--green-light);
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 600;
  }

  .contact-cta h2 {
    font-size: clamp(2rem, 5vw, 3rem);
    max-width: 16ch;
  }

  .contact-cta__desc {
    max-width: 36rem;
    color: color-mix(in srgb, var(--white) 88%, transparent);
  }

  .contact-cta__form {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    justify-content: center;
    margin-top: 0.75rem;
    width: min(100%, 42rem);
  }

  .contact-cta__form input {
    flex: 1 1 12rem;
    min-height: 3rem;
    border-radius: var(--radius-pill);
    border: 1px solid color-mix(in srgb, var(--white) 35%, transparent);
    background: color-mix(in srgb, var(--ink) 22%, var(--purple));
    color: var(--white);
    padding: 0.65rem 1.1rem;
  }

  .contact-cta__form input::placeholder {
    color: color-mix(in srgb, var(--white) 65%, transparent);
  }

  .contact-cta__form button {
    min-height: 3rem;
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--white);
    color: var(--green);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.65rem 1.35rem;
    cursor: pointer;
    transition: transform 0.2s ease;
  }

  .contact-cta__form button:hover {
    transform: scale(1.03);
  }

  .contact-cta__hint {
    font-size: 0.85rem;
    color: color-mix(in srgb, var(--white) 75%, transparent);
  }

  .contact-cta__hint a {
    color: var(--green-light);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
