---
import { site } from "../../content/site";
---

<footer class="site-footer">
  <div class="container site-footer__grid">
    <div class="site-footer__brand">
      <p class="brand-line">
        <span class="brand-line__mark" aria-hidden="true"></span>
        {site.name}
      </p>
      <p class="muted">
        Regional summits, survey findings, and campus practice on AI in teaching and learning—
        organized with support from the {site.org}.
      </p>
    </div>
    <div class="site-footer__cols">
      <div>
        <h3>Events</h3>
        <ul>
          <li><a href="/events/november-2026">November 17</a></li>
          <li><a href="/events/brain-hub">Brain Hub</a></li>
          <li><a href="/events/january-event">January Event</a></li>
          <li><a href="/events">All events</a></li>
        </ul>
      </div>
      <div>
        <h3>Explore</h3>
        <ul>
          <li><a href="/issues">Top 10 Issues</a></li>
          <li><a href="/schools">Schools</a></li>
          <li><a href="/about">About</a></li>
          <li><a href="/resources">Resources</a></li>
        </ul>
      </div>
      <div>
        <h3>Connect</h3>
        <ul>
          <li><a href="/contact">Contact</a></li>
          <li><a href="/awards">Faculty awards</a></li>
          <li>
            <a href={site.registerUrl} target="_blank" rel="noopener noreferrer">Register</a>
          </li>
        </ul>
      </div>
    </div>
  </div>
  <div class="container site-footer__bar">
    <p>© {new Date().getFullYear()} {site.name}. {site.org}.</p>
    <p class="site-footer__legal">
      <a href="/resources">Resources</a>
      <span aria-hidden="true">·</span>
      <a href="/contact">Questions</a>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    background: color-mix(in srgb, var(--green-light) 28%, var(--cream));
    padding-top: 3.5rem;
    border-top: 1px solid color-mix(in srgb, var(--green) 18%, transparent);
  }

  .site-footer__grid {
    display: grid;
    grid-template-columns: 1.2fr 1.8fr;
    gap: 2.5rem;
    padding-bottom: 2.5rem;
  }

  .brand-line {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-size: 1.35rem;
    margin-bottom: 0.85rem;
  }

  .brand-line__mark {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 999px;
    background: var(--green);
  }

  .site-footer__brand .muted {
    max-width: 28rem;
  }

  .site-footer__cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .site-footer h3 {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink);
    margin-bottom: 0.85rem;
  }

  .site-footer ul {
    list-style: none;
    display: grid;
    gap: 0.45rem;
  }

  .site-footer a {
    color: var(--muted);
    text-decoration: none;
  }

  .site-footer a:hover {
    color: var(--purple);
  }

  .site-footer__bar {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-block: 1.1rem;
    border-top: 1px solid color-mix(in srgb, var(--purple) 16%, transparent);
    color: var(--muted);
    font-size: 0.9rem;
  }

  .site-footer__legal {
    display: inline-flex;
    gap: 0.55rem;
  }

  @media (max-width: 800px) {
    .site-footer__grid {
      grid-template-columns: 1fr;
    }

    .site-footer__cols {
      grid-template-columns: 1fr;
    }
  }
</style>
