---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/ui/Button.astro";
import ScheduleTimeline from "../../components/events/ScheduleTimeline.astro";
import ContactCta from "../../components/layout/ContactCta.astro";
import { events, getEvent, getProgramLines } from "../../content/events";
import { site } from "../../content/site";

export function getStaticPaths() {
  return events.map((event) => ({
    params: { slug: event.slug },
  }));
}

const { slug } = Astro.params;
const event = getEvent(slug!);

if (!event) {
  return Astro.redirect("/events");
}

const programLines = getProgramLines(event);
const hasSchedule = Boolean(event.sessions?.length);
---

<BaseLayout title={event.title} description={event.summary}>
  <section class="section event-hero">
    <div class="container event-hero__inner">
      <p class="eyebrow">{event.category}</p>
      <h1>{event.title}</h1>
      <p class="event-hero__meta">
        <span>{event.dateLabel}</span>
        {event.location && <span>· {event.location}</span>}
      </p>
      <p class="event-hero__summary muted">{event.summary}</p>
      <div class="event-hero__actions">
        {
          event.registerUrl && (
            <Button href={event.registerUrl} external>
              Register for Nov 13
            </Button>
          )
        }
        <Button href="/events" variant="secondary">All events</Button>
      </div>
    </div>
  </section>

  <section class="section section--tight event-program" id="program">
    <div class="container">
      <div class="event-program__head">
        <p class="eyebrow">Program</p>
        <h2>{hasSchedule ? "Day schedule" : "Session outline"}</h2>
        {
          hasSchedule && (
            <p class="muted">
              Follow the day left to right. Select any session for speakers, notes, and table topics.
            </p>
          )
        }
      </div>

      {
        hasSchedule ? (
          <div class="event-program__timeline">
            <ScheduleTimeline
              sessions={event.sessions!}
              idPrefix={`page-${event.slug}`}
              size="full"
            />
          </div>
        ) : (
          <ol class="event-program__list">
            {programLines.map((item) => (
              <li>{item}</li>
            ))}
          </ol>
        )
      }
    </div>
  </section>

  {
    event.status === "upcoming" && (
      <section class="section section--tight" id="register">
        <div class="container event-register">
          <div>
            <p class="eyebrow">Registration</p>
            <h2>Join us November 13</h2>
            <p class="muted">
              Registration is hosted on a separate site. Capacity at Mars Hill University is about
              120 educators.
            </p>
          </div>
          <Button href={event.registerUrl ?? site.registerUrl} external>
            Register for Nov 13
          </Button>
        </div>
      </section>
    )
  }

  <ContactCta />
</BaseLayout>

<style>
  .event-hero__inner {
    max-width: 46rem;
  }

  .event-hero h1 {
    font-size: clamp(2.2rem, 5vw, 3.4rem);
    margin: 0.4rem 0 0.75rem;
    max-width: 18ch;
    line-height: 1.12;
  }

  .event-hero__meta {
    color: var(--blue);
    font-weight: 600;
    margin-bottom: 1rem;
  }

  .event-hero__summary {
    max-width: 40rem;
    margin-bottom: 1.5rem;
  }

  .event-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .event-program {
    background: color-mix(in srgb, var(--cream) 70%, white);
  }

  .event-program__head {
    margin-bottom: 1.35rem;
    max-width: 40rem;
  }

  .event-program__head h2 {
    font-size: clamp(1.75rem, 3.5vw, 2.35rem);
    margin: 0.3rem 0 0.5rem;
  }

  .event-program__timeline {
    margin-inline: calc(-1 * min(var(--page-gutter), 0.5rem));
  }

  .event-program__list {
    padding-left: 1.25rem;
    display: grid;
    gap: 0.65rem;
    max-width: 42rem;
    color: var(--muted);
  }

  .event-register {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    align-items: center;
    flex-wrap: wrap;
    padding: 2rem;
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--green-light) 35%, white);
  }

  .event-register h2 {
    font-size: clamp(1.6rem, 3vw, 2rem);
    margin: 0.35rem 0 0.5rem;
  }

  @media (max-width: 640px) {
    .event-hero__actions {
      flex-direction: column;
      align-items: stretch;
    }

    .event-hero__actions :global(.btn) {
      width: 100%;
      justify-content: center;
    }

    .event-register {
      flex-direction: column;
      align-items: stretch;
    }

    .event-register :global(.btn) {
      width: 100%;
      justify-content: center;
    }
  }
</style>
