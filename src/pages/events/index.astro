---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/ui/Button.astro";
import ScheduleTimeline from "../../components/events/ScheduleTimeline.astro";
import PastEventCard from "../../components/events/PastEventCard.astro";
import PastEventDialogs from "../../components/events/PastEventDialogs.astro";
import ParticipatingOrgs from "../../components/events/ParticipatingOrgs.astro";
import ContactCta from "../../components/layout/ContactCta.astro";
import { events } from "../../content/events";

const upcoming = events.find((e) => e.status === "upcoming");
const past = events.filter((e) => e.status === "past");
---

<BaseLayout
  title="November 13 · Events"
  description="Friday, November 13, 2026 Educators’ Exchange at Mars Hill University—plus previous WNC regional gatherings."
>
  {
    upcoming && (
      <>
      <section class="section" id="upcoming">
        <div class="container">
          <article class="events-page__featured" data-reveal data-reveal-y="28">
            <div class="events-page__featured-head">
              <div class="events-page__featured-copy">
                <p class="events-page__status">Upcoming · {upcoming.category}</p>
                <p class="events-page__date">{upcoming.dateLabel}</p>
                <h1>{upcoming.title}</h1>
                <p class="events-page__meta">
                  {upcoming.location && <span>{upcoming.location}</span>}
                </p>
                <p class="events-page__summary">{upcoming.summary}</p>
                <div class="events-page__actions">
                  {upcoming.registerUrl && (
                    <Button href={upcoming.registerUrl} external>
                      Register for Nov 13
                    </Button>
                  )}
                  <Button href={`/events/${upcoming.slug}`} variant="secondary">
                    Full program
                  </Button>
                </div>
              </div>
              {upcoming.images[0] && (
                <figure class="events-page__featured-photo">
                  <img
                    src={upcoming.images[0].src}
                    alt={upcoming.images[0].alt}
                    width="480"
                    height="360"
                  />
                  <figcaption>November 13 · Mars Hill University</figcaption>
                </figure>
              )}
            </div>

            {upcoming.sessions?.length ? (
              <div class="events-page__schedule">
                {
                  upcoming.beforeEvent && upcoming.beforeEvent.length > 0 && (
                    <aside class="events-page__prep">
                      <p class="eyebrow">Before the event</p>
                      <ul>
                        {upcoming.beforeEvent.map((item) => (
                          <li>{item}</li>
                        ))}
                      </ul>
                    </aside>
                  )
                }

                <details class="events-page__sched-fold">
                  <summary class="events-page__sched-summary">
                    <span class="events-page__sched-summary-copy">
                      <span class="events-page__sched-summary-eyebrow">Program</span>
                      <span class="events-page__sched-summary-title">Day schedule</span>
                      <span class="events-page__sched-summary-meta">
                        {upcoming.sessions.length} sessions · tap to expand speakers &amp; notes
                      </span>
                    </span>
                    <span class="events-page__sched-summary-action" aria-hidden="true">
                      <span class="events-page__sched-summary-open">Show schedule ↓</span>
                      <span class="events-page__sched-summary-close">Hide schedule ↑</span>
                    </span>
                  </summary>
                  <div class="events-page__sched-body">
                    <ScheduleTimeline
                      sessions={upcoming.sessions}
                      idPrefix="events-index-nov"
                      size="compact"
                      layout="vertical"
                      showDetail
                    />
                  </div>
                </details>
              </div>
            ) : null}
          </article>
        </div>
      </section>

      {upcoming.participatingOrgs && upcoming.participatingOrgs.length > 0 && (
        <ParticipatingOrgs
          orgs={upcoming.participatingOrgs}
          heading="Participating organizations"
          lede="Host campus, sponsoring institutions, and partners for the November Exchange."
        />
      )}
      </>
    )
  }

  {
    past.length > 0 && (
      <section class="section" id="archive">
        <div class="container">
          <div class="events-page__past-head" data-reveal>
            <p class="eyebrow">Archive</p>
            <h2 class="events-page__past-title">Previous gatherings</h2>
            <p class="muted">
              Earlier convenings that fed the survey conversation and the regional workplan. Open a
              card for photos and gathering details.
            </p>
          </div>

          <div class="events-page__past-grid">
            {
              past.map((event, index) => (
                <PastEventCard event={event} revealDelay={String(0.06 * index)} />
              ))
            }
          </div>
        </div>
      </section>
    )
  }

  <ContactCta
    title="Questions about November 13?"
    description="Registration, program details, or bringing a campus team—send a note and we will follow up."
  />
</BaseLayout>

<PastEventDialogs events={events} />

<style>
  .events-page__featured {
    display: grid;
    gap: 1.5rem;
    padding: clamp(1.15rem, 3vw, 1.85rem);
    border-radius: var(--radius-lg);
    background:
      linear-gradient(
        160deg,
        color-mix(in srgb, var(--green-light) 28%, white),
        color-mix(in srgb, var(--cream) 88%, white)
      );
    border: 1px solid color-mix(in srgb, var(--green) 14%, transparent);
  }

  .events-page__featured-head {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 0.85fr);
    gap: clamp(1rem, 3vw, 1.75rem);
    align-items: start;
  }

  .events-page__status {
    margin: 0 0 0.55rem;
    color: var(--green);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .events-page__date {
    margin: 0 0 0.35rem;
    color: var(--blue);
    font-family: var(--font-display);
    font-size: clamp(1.55rem, 3.2vw, 2.1rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .events-page__featured-copy h1 {
    margin: 0 0 0.5rem;
    font-size: clamp(1.85rem, 3.8vw, 2.65rem);
    line-height: 1.12;
    max-width: none;
    text-wrap: balance;
  }

  .events-page__meta {
    margin: 0 0 0.75rem;
    color: var(--green-strong, var(--green));
    font-weight: 600;
  }

  .events-page__summary {
    margin: 0 0 1.1rem;
    color: var(--muted);
    max-width: 40rem;
  }

  .events-page__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .events-page__featured-photo {
    margin: 0;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: color-mix(in srgb, var(--green-light) 35%, white);
    border: 1px solid color-mix(in srgb, var(--green) 12%, transparent);
  }

  .events-page__featured-photo img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    max-height: 16rem;
    object-fit: cover;
  }

  .events-page__featured-photo figcaption {
    padding: 0.55rem 0.75rem 0.7rem;
    font-size: 0.8rem;
    color: var(--muted);
    background: color-mix(in srgb, var(--white) 70%, transparent);
  }

  .events-page__schedule {
    padding-top: 1.15rem;
    border-top: 1px solid color-mix(in srgb, var(--green) 16%, transparent);
    display: grid;
    gap: 1rem;
  }

  .events-page__prep {
    margin: 0;
    padding: 1rem 1.15rem;
    max-width: 42rem;
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--green-light) 28%, white);
    border: 1px solid color-mix(in srgb, var(--green) 16%, transparent);
  }

  .events-page__prep ul {
    margin: 0.45rem 0 0;
    padding-left: 1.15rem;
    display: grid;
    gap: 0.4rem;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .events-page__sched-fold {
    border-radius: var(--radius-lg);
    border: 1px solid color-mix(in srgb, var(--green) 22%, transparent);
    background: color-mix(in srgb, var(--white) 72%, var(--cream));
    overflow: hidden;
  }

  .events-page__sched-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.15rem;
    cursor: pointer;
    list-style: none;
  }

  .events-page__sched-summary::-webkit-details-marker {
    display: none;
  }

  .events-page__sched-summary:hover {
    background: color-mix(in srgb, var(--green-light) 22%, white);
  }

  .events-page__sched-summary:focus-visible {
    outline: 2px solid var(--blue);
    outline-offset: -2px;
  }

  .events-page__sched-summary-copy {
    display: grid;
    gap: 0.2rem;
    min-width: 0;
  }

  .events-page__sched-summary-eyebrow {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--green-strong);
  }

  .events-page__sched-summary-title {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.4vw, 1.55rem);
    font-weight: 600;
    color: var(--ink);
  }

  .events-page__sched-summary-meta {
    font-size: 0.9rem;
    color: var(--muted);
  }

  .events-page__sched-summary-action {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding: 0.55rem 1.15rem;
    border-radius: var(--radius-pill);
    background: var(--green);
    color: var(--white);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    white-space: nowrap;
  }

  .events-page__sched-summary-close {
    display: none;
  }

  .events-page__sched-fold[open] .events-page__sched-summary-open {
    display: none;
  }

  .events-page__sched-fold[open] .events-page__sched-summary-close {
    display: inline;
  }

  .events-page__sched-fold[open] .events-page__sched-summary-action {
    background: color-mix(in srgb, var(--ink) 78%, var(--green));
  }

  .events-page__sched-body {
    padding: 0 1rem 1.15rem;
    border-top: 1px solid color-mix(in srgb, var(--green) 14%, transparent);
  }

  .events-page__past-head {
    max-width: 40rem;
    margin-bottom: 1.35rem;
  }

  .events-page__past-head h2 {
    margin: 0.3rem 0 0.5rem;
    font-size: clamp(1.9rem, 3.4vw, 2.5rem);
  }

  .events-page__past-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 2.5vw, 1.5rem);
  }

  @media (max-width: 900px) {
    .events-page__featured-head {
      grid-template-columns: 1fr;
    }

    .events-page__featured-photo {
      max-width: 22rem;
    }

    .events-page__featured-photo img {
      max-height: 12rem;
    }
  }

  @media (max-width: 720px) {
    .events-page__past-grid {
      grid-template-columns: 1fr;
    }

    .events-page__actions {
      flex-direction: column;
      align-items: stretch;
    }

    .events-page__actions :global(.btn) {
      width: 100%;
      justify-content: center;
    }

    .events-page__sched-summary {
      flex-direction: column;
      align-items: stretch;
    }

    .events-page__sched-summary-action {
      width: 100%;
    }
  }
</style>
