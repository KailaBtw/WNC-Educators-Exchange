---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/ui/Button.astro";
import ScheduleTimeline from "../../components/events/ScheduleTimeline.astro";
import EventCarousel from "../../components/events/EventCarousel";
import ContactCta from "../../components/layout/ContactCta.astro";
import { events, getProgramLines } from "../../content/events";

const upcoming = events.find((e) => e.status === "upcoming");
const past = events.filter((e) => e.status === "past");

const archiveSlides = past.flatMap((event) =>
  event.images.map((img) => ({
    src: img.src,
    alt: img.alt,
    caption: img.caption ?? event.title,
    subtitle: img.subtitle ? `${event.dateLabel} · ${img.subtitle}` : event.dateLabel,
  })),
);
---

<BaseLayout
  title="Events"
  description="Past and upcoming WNC Educators Exchange gatherings, including the November 13 event at Mars Hill University."
>
  <section class="section events-page-hero">
    <div class="container events-page-hero__inner">
      <p class="eyebrow">Events</p>
      <h1>Regional gatherings</h1>
      <p class="events-page-hero__dek">
        Brain Hub and January shaped the Top 10 Issues report. November 13 at Mars Hill is next—scan
        the day schedule, register, or reopen what came before.
      </p>
      <div class="events-page-hero__jumps">
        <a href="#upcoming">Upcoming</a>
        <a href="#archive">Previous</a>
        <a href="#photos">Photos</a>
      </div>
    </div>
  </section>

  {
    upcoming && (
      <section class="section section--tight" id="upcoming">
        <div class="container">
          <article class="events-page__featured" data-reveal data-reveal-y="28">
            <header class="events-page__featured-head">
              <div class="events-page__featured-copy">
                <p class="events-page__status">Upcoming · {upcoming.category}</p>
                <h2>{upcoming.title}</h2>
                <p class="events-page__meta">
                  <span>{upcoming.dateLabel}</span>
                  {upcoming.location && <span>· {upcoming.location}</span>}
                </p>
                <p class="events-page__summary">{upcoming.summary}</p>
                <div class="events-page__actions">
                  <Button href={`/events/${upcoming.slug}`}>Event details</Button>
                  {upcoming.registerUrl && (
                    <Button href={upcoming.registerUrl} variant="secondary" external>
                      Register for Nov 13
                    </Button>
                  )}
                </div>
              </div>
              {upcoming.images[0] && (
                <figure class="events-page__featured-photo">
                  <img
                    src={upcoming.images[0].src}
                    alt={upcoming.images[0].alt}
                    width="480"
                    height="360"
                  />
                  <figcaption>{upcoming.images[0].caption ?? "November Exchange"}</figcaption>
                </figure>
              )}
            </header>

            {upcoming.sessions?.length ? (
              <div class="events-page__schedule">
                <div class="events-page__schedule-head">
                  <p class="eyebrow">Program</p>
                  <h3>Full day schedule</h3>
                  <p class="muted">
                    Scroll sideways across the day. Select a session for speakers, notes, and table
                    topics—or open the event page for the same schedule in context.
                  </p>
                </div>
                <ScheduleTimeline
                  sessions={upcoming.sessions}
                  idPrefix="events-index-nov"
                  size="full"
                />
              </div>
            ) : null}
          </article>
        </div>
      </section>
    )
  }

  {
    past.length > 0 && (
      <section class="section" id="archive">
        <div class="container">
          <div class="events-page__past-head" data-reveal>
            <p class="eyebrow">Archive</p>
            <h2>Previous gatherings</h2>
            <p class="muted">
              Earlier convenings that fed the survey conversation and the regional workplan. Open a
              card for the session outline.
            </p>
          </div>

          <div class="events-page__past-grid">
            {past.map((event, index) => (
              <button
                type="button"
                class="events-page__past-card"
                data-open-past-event={event.slug}
                data-reveal
                data-reveal-delay={String(0.06 * index)}
                data-reveal-y="24"
                aria-haspopup="dialog"
              >
                <span class="events-page__past-thumb" aria-hidden="true">
                  <img src={event.images[0]?.src} alt="" width="72" height="72" />
                </span>
                <span class="events-page__past-copy">
                  <span class="events-page__past-date">{event.dateLabel}</span>
                  <span class="events-page__past-title">{event.title}</span>
                  <span class="events-page__past-summary">{event.summary}</span>
                </span>
              </button>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    archiveSlides.length > 0 && (
      <section class="section section--tight" id="photos">
        <div class="container" data-reveal data-reveal-y="24">
          <EventCarousel
            client:load
            slides={archiveSlides}
            heading="From past gatherings"
            body="Real photos from Brain Hub (June) and the January AI Summit. Browse here, then open an event card above for the session outline."
          />
        </div>
      </section>
    )
  }

  <ContactCta
    title="Questions about November 13?"
    description="Registration, program details, or bringing a campus team—send a note and we will follow up."
  />
</BaseLayout>

{
  past.map((event) => (
    <dialog
      class="past-dialog"
      id={`past-dialog-${event.slug}`}
      aria-labelledby={`past-dialog-title-${event.slug}`}
    >
      <div class="past-dialog__panel">
        <header class="past-dialog__header">
          <div>
            <p class="past-dialog__kicker">Previous gathering</p>
            <h2 id={`past-dialog-title-${event.slug}`}>{event.title}</h2>
            <p class="past-dialog__meta">{event.dateLabel}</p>
          </div>
          <button type="button" class="past-dialog__close" data-close-past-dialog aria-label="Close">
            <span aria-hidden="true">×</span>
          </button>
        </header>
        <div class="past-dialog__body">
          <p class="past-dialog__summary">{event.summary}</p>
          <div class="past-dialog__program">
            <h3>Session outline</h3>
            <ol>
              {getProgramLines(event).map((item) => (
                <li>{item}</li>
              ))}
            </ol>
          </div>
          <div class="past-dialog__actions">
            <Button href={`/events/${event.slug}`} variant="quiet">
              Open event page
            </Button>
          </div>
        </div>
      </div>
    </dialog>
  ))
}

<script>
  document.querySelectorAll<HTMLElement>("[data-open-past-event]").forEach((el) => {
    el.addEventListener("click", () => {
      const slug = el.dataset.openPastEvent;
      if (!slug) return;
      const dialog = document.getElementById(`past-dialog-${slug}`) as HTMLDialogElement | null;
      dialog?.showModal();
    });
  });

  document.querySelectorAll<HTMLButtonElement>("[data-close-past-dialog]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const dialog = btn.closest("dialog") as HTMLDialogElement | null;
      dialog?.close();
    });
  });

  document.querySelectorAll<HTMLDialogElement>(".past-dialog").forEach((dialog) => {
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
  });
</script>

<style>
  .events-page-hero__inner {
    max-width: 42rem;
  }

  .events-page-hero h1 {
    font-size: clamp(2.3rem, 5vw, 3.4rem);
    margin: 0.35rem 0 0.75rem;
  }

  .events-page-hero__dek {
    color: var(--muted);
    margin: 0 0 1.15rem;
  }

  .events-page-hero__jumps {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.15rem;
  }

  .events-page-hero__jumps a {
    color: var(--green);
    font-weight: 700;
    font-size: 0.92rem;
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--green) 35%, transparent);
  }

  .events-page-hero__jumps a:hover {
    border-bottom-color: var(--green);
  }

  .events-page__featured {
    display: grid;
    gap: 1.5rem;
    padding: clamp(1.15rem, 3vw, 1.85rem);
    border-radius: var(--radius-lg);
    background:
      linear-gradient(
        160deg,
        color-mix(in srgb, var(--green-light) 28%, white),
        color-mix(in srgb, var(--cream) 88%, white)
      );
    border: 1px solid color-mix(in srgb, var(--green) 14%, transparent);
  }

  .events-page__featured-head {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 0.85fr);
    gap: clamp(1rem, 3vw, 1.75rem);
    align-items: start;
  }

  .events-page__status {
    margin: 0 0 0.35rem;
    color: var(--green);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .events-page__featured-copy h2 {
    margin: 0 0 0.45rem;
    font-size: clamp(1.7rem, 3.4vw, 2.4rem);
    line-height: 1.15;
    max-width: 18ch;
  }

  .events-page__meta {
    margin: 0 0 0.75rem;
    color: var(--blue);
    font-weight: 600;
  }

  .events-page__summary {
    margin: 0 0 1.1rem;
    color: var(--muted);
    max-width: 40rem;
  }

  .events-page__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .events-page__featured-photo {
    margin: 0;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: color-mix(in srgb, var(--green-light) 35%, white);
    border: 1px solid color-mix(in srgb, var(--green) 12%, transparent);
  }

  .events-page__featured-photo img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    max-height: 16rem;
    object-fit: cover;
  }

  .events-page__featured-photo figcaption {
    padding: 0.55rem 0.75rem 0.7rem;
    font-size: 0.8rem;
    color: var(--muted);
    background: color-mix(in srgb, var(--white) 70%, transparent);
  }

  .events-page__schedule {
    padding-top: 1.15rem;
    border-top: 1px solid color-mix(in srgb, var(--green) 16%, transparent);
  }

  .events-page__schedule-head {
    margin-bottom: 1rem;
    max-width: 40rem;
  }

  .events-page__schedule-head h3 {
    margin: 0.3rem 0 0.45rem;
    font-size: clamp(1.35rem, 2.6vw, 1.75rem);
  }

  .events-page__past-head {
    max-width: 40rem;
    margin-bottom: 1.25rem;
  }

  .events-page__past-head h2 {
    margin: 0.3rem 0 0.5rem;
    font-size: clamp(1.7rem, 3vw, 2.25rem);
  }

  .events-page__past-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .events-page__past-card {
    display: flex;
    gap: 0.95rem;
    align-items: flex-start;
    width: 100%;
    min-width: 0;
    margin: 0;
    padding: 1rem;
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--white) 70%, var(--cream));
    border: 1px solid color-mix(in srgb, var(--ink) 6%, transparent);
    text-align: left;
    color: inherit;
    font: inherit;
    cursor: pointer;
    transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  .events-page__past-card:hover,
  .events-page__past-card:focus-visible {
    border-color: color-mix(in srgb, var(--blue) 35%, transparent);
    transform: translateY(-2px);
    box-shadow: 0 10px 24px color-mix(in srgb, var(--ink) 6%, transparent);
    outline: none;
  }

  .events-page__past-thumb {
    flex: 0 0 3.75rem;
    width: 3.75rem;
    height: 3.75rem;
    border-radius: 0.65rem;
    overflow: hidden;
    background: color-mix(in srgb, var(--green-light) 40%, white);
  }

  .events-page__past-thumb img {
    display: block;
    width: 3.75rem;
    height: 3.75rem;
    object-fit: cover;
  }

  .events-page__past-copy {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-width: 0;
    flex: 1;
  }

  .events-page__past-date,
  .events-page__past-title,
  .events-page__past-summary {
    display: block;
  }

  .events-page__past-date {
    color: var(--blue);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .events-page__past-title {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 600;
    line-height: 1.25;
  }

  .events-page__past-summary {
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.45;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .past-dialog {
    width: min(30rem, calc(100vw - 1.5rem));
    max-height: min(88vh, 36rem);
    padding: 0;
    border: 0;
    border-radius: var(--radius-lg);
    background: var(--cream);
    box-shadow: 0 28px 64px color-mix(in srgb, var(--ink) 26%, transparent);
  }

  .past-dialog::backdrop {
    background: color-mix(in srgb, var(--ink) 48%, transparent);
  }

  .past-dialog__panel {
    display: flex;
    flex-direction: column;
    max-height: min(88vh, 36rem);
  }

  .past-dialog__header {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: flex-start;
    padding: 1.35rem 1.35rem 1.1rem;
    border-bottom: 1px solid color-mix(in srgb, var(--ink) 8%, transparent);
    background: color-mix(in srgb, var(--white) 72%, var(--cream));
  }

  .past-dialog__kicker {
    margin: 0 0 0.3rem;
    color: var(--blue);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .past-dialog__header h2 {
    margin: 0;
    font-size: clamp(1.35rem, 3vw, 1.7rem);
    line-height: 1.2;
  }

  .past-dialog__meta {
    margin: 0.4rem 0 0;
    color: var(--muted);
    font-size: 0.92rem;
    font-weight: 600;
  }

  .past-dialog__close {
    flex-shrink: 0;
    width: 2.35rem;
    height: 2.35rem;
    border: 0;
    border-radius: 999px;
    background: color-mix(in srgb, var(--ink) 6%, white);
    color: var(--ink);
    font-size: 1.45rem;
    line-height: 1;
    cursor: pointer;
  }

  .past-dialog__body {
    padding: 1.2rem 1.35rem 1.45rem;
    overflow: auto;
  }

  .past-dialog__summary {
    margin: 0 0 1.15rem;
    color: var(--muted);
    line-height: 1.5;
  }

  .past-dialog__program h3 {
    margin: 0 0 0.65rem;
    font-size: 0.95rem;
  }

  .past-dialog__program ol {
    margin: 0;
    padding-left: 1.15rem;
    display: grid;
    gap: 0.4rem;
    color: var(--muted);
    font-size: 0.92rem;
  }

  .past-dialog__actions {
    margin-top: 1.25rem;
  }

  @media (max-width: 900px) {
    .events-page__featured-head {
      grid-template-columns: 1fr;
    }

    .events-page__featured-photo {
      order: -1;
      max-width: 22rem;
    }

    .events-page__featured-photo img {
      max-height: 12rem;
    }
  }

  @media (max-width: 720px) {
    .events-page__past-grid {
      grid-template-columns: 1fr;
    }

    .events-page__actions {
      flex-direction: column;
      align-items: stretch;
    }

    .events-page__actions :global(.btn) {
      width: 100%;
      justify-content: center;
    }
  }
</style>
