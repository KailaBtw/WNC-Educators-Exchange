---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHeader from "../../components/ui/SectionHeader.astro";
import EventCard from "../../components/events/EventCard.astro";
import EventCarousel from "../../components/events/EventCarousel";
import ContactCta from "../../components/layout/ContactCta.astro";
import { events } from "../../content/events";

const carouselSlides = events.flatMap((event) => event.images).slice(0, 6);
---

<BaseLayout
  title="Events"
  description="Past and upcoming WNC Educators Exchange gatherings, including the November 17 event."
>
  <section class="section">
    <div class="container">
      <SectionHeader eyebrow="Events" title="Summits, past and upcoming">
        <p>
          Archives from Brain Hub and January, plus the November 17 program and registration link.
          Photo placeholders mark where event images will go.
        </p>
      </SectionHeader>
      <div class="events-page__grid">
        {events.map((event) => <EventCard event={event} />)}
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <EventCarousel
        client:load
        slides={carouselSlides}
        heading="From the room"
        body="Photos from Brain Hub, January, and upcoming convenings will live here. Until then, these slides hold the layout."
      />
    </div>
  </section>

  <ContactCta
    title="Questions about November 17?"
    description="Registration, program details, or bringing a campus team—send a note and we will follow up."
  />
</BaseLayout>

<style>
  .events-page__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
  }

  @media (max-width: 900px) {
    .events-page__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
