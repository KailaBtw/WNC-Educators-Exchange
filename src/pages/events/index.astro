---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/ui/Button.astro";
import ScheduleTimeline from "../../components/events/ScheduleTimeline.astro";
import EventCarousel from "../../components/events/EventCarousel";
import PastEventCard from "../../components/events/PastEventCard.astro";
import PastEventDialogs from "../../components/events/PastEventDialogs.astro";
import ContactCta from "../../components/layout/ContactCta.astro";
import { events } from "../../content/events";

const upcoming = events.find((e) => e.status === "upcoming");
const past = events.filter((e) => e.status === "past");

const archiveSlides = past.flatMap((event) =>
  event.images.map((img) => ({
    src: img.src,
    alt: img.alt,
    caption: img.caption ?? event.title,
    subtitle: img.subtitle ? `${event.dateLabel} · ${img.subtitle}` : event.dateLabel,
  })),
);
---

<BaseLayout
  title="Events"
  description="Past and upcoming WNC Educators Exchange gatherings, including the November 13 event at Mars Hill University."
>
  <section class="section events-page-hero">
    <div class="container events-page-hero__inner">
      <p class="eyebrow">Events</p>
      <h1>Regional gatherings</h1>
      <p class="events-page-hero__dek">
        Brain Hub and January shaped the Top 10 Issues report. November 13 at Mars Hill is next—scan
        the day schedule, register, or reopen what came before.
      </p>
    </div>
  </section>

  {
    upcoming && (
      <section class="section section--tight" id="upcoming">
        <div class="container">
          <article class="events-page__featured" data-reveal data-reveal-y="28">
            <header class="events-page__featured-head">
              <div class="events-page__featured-copy">
                <p class="events-page__status">Upcoming · {upcoming.category}</p>
                <h2>{upcoming.title}</h2>
                <p class="events-page__meta">
                  <span>{upcoming.dateLabel}</span>
                  {upcoming.location && <span>· {upcoming.location}</span>}
                </p>
                <p class="events-page__summary">{upcoming.summary}</p>
                <div class="events-page__actions">
                  {upcoming.registerUrl && (
                    <Button href={upcoming.registerUrl} external>
                      Register for Nov 13
                    </Button>
                  )}
                </div>
              </div>
              {upcoming.images[0] && (
                <figure class="events-page__featured-photo">
                  <img
                    src={upcoming.images[0].src}
                    alt={upcoming.images[0].alt}
                    width="480"
                    height="360"
                  />
                  <figcaption>{upcoming.images[0].caption ?? "November Exchange"}</figcaption>
                </figure>
              )}
            </header>

            {upcoming.sessions?.length ? (
              <div class="events-page__schedule">
                <div class="events-page__schedule-head">
                  <p class="eyebrow">Program</p>
                  <h3>Full day schedule</h3>
                  <p class="muted">
                    Scroll sideways across the day. Select a session for speakers, notes, and table
                    topics.
                  </p>
                </div>
                {
                  upcoming.beforeEvent && upcoming.beforeEvent.length > 0 && (
                    <aside class="events-page__prep">
                      <p class="eyebrow">Before the event</p>
                      <ul>
                        {upcoming.beforeEvent.map((item) => (
                          <li>{item}</li>
                        ))}
                      </ul>
                    </aside>
                  )
                }
                <ScheduleTimeline
                  sessions={upcoming.sessions}
                  idPrefix="events-index-nov"
                  size="full"
                />
              </div>
            ) : null}
          </article>
        </div>
      </section>
    )
  }

  {
    past.length > 0 && (
      <section class="section" id="archive">
        <div class="container">
          <div class="events-page__past-head" data-reveal>
            <p class="eyebrow">Archive</p>
            <h2>Previous gatherings</h2>
            <p class="muted">
              Earlier convenings that fed the survey conversation and the regional workplan. Open a
              card for photos and the session outline.
            </p>
          </div>

          <div class="events-page__past-grid">
            {
              past.map((event, index) => (
                <PastEventCard event={event} revealDelay={String(0.06 * index)} />
              ))
            }
          </div>
        </div>
      </section>
    )
  }

  {
    archiveSlides.length > 0 && (
      <section class="section section--tight" id="photos">
        <div class="container" data-reveal data-reveal-y="24">
          <EventCarousel
            client:load
            slides={archiveSlides}
            heading="From past gatherings"
            body="Real photos from Brain Hub (June) and the January AI Summit. Browse here, then open an event card above for the session outline."
          />
        </div>
      </section>
    )
  }

  <ContactCta
    title="Questions about November 13?"
    description="Registration, program details, or bringing a campus team—send a note and we will follow up."
  />
</BaseLayout>

<PastEventDialogs events={events} />

<style>
  .events-page-hero__inner {
    max-width: 42rem;
  }

  .events-page-hero h1 {
    font-size: clamp(2.3rem, 5vw, 3.4rem);
    margin: 0.35rem 0 0.75rem;
  }

  .events-page-hero__dek {
    color: var(--muted);
    margin: 0;
  }

  .events-page__featured {
    display: grid;
    gap: 1.5rem;
    padding: clamp(1.15rem, 3vw, 1.85rem);
    border-radius: var(--radius-lg);
    background:
      linear-gradient(
        160deg,
        color-mix(in srgb, var(--green-light) 28%, white),
        color-mix(in srgb, var(--cream) 88%, white)
      );
    border: 1px solid color-mix(in srgb, var(--green) 14%, transparent);
  }

  .events-page__featured-head {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 0.85fr);
    gap: clamp(1rem, 3vw, 1.75rem);
    align-items: start;
  }

  .events-page__status {
    margin: 0 0 0.35rem;
    color: var(--green);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .events-page__featured-copy h2 {
    margin: 0 0 0.45rem;
    font-size: clamp(1.7rem, 3.4vw, 2.4rem);
    line-height: 1.15;
    max-width: 18ch;
  }

  .events-page__meta {
    margin: 0 0 0.75rem;
    color: var(--blue);
    font-weight: 600;
  }

  .events-page__summary {
    margin: 0 0 1.1rem;
    color: var(--muted);
    max-width: 40rem;
  }

  .events-page__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .events-page__featured-photo {
    margin: 0;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: color-mix(in srgb, var(--green-light) 35%, white);
    border: 1px solid color-mix(in srgb, var(--green) 12%, transparent);
  }

  .events-page__featured-photo img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    max-height: 16rem;
    object-fit: cover;
  }

  .events-page__featured-photo figcaption {
    padding: 0.55rem 0.75rem 0.7rem;
    font-size: 0.8rem;
    color: var(--muted);
    background: color-mix(in srgb, var(--white) 70%, transparent);
  }

  .events-page__schedule {
    padding-top: 1.15rem;
    border-top: 1px solid color-mix(in srgb, var(--green) 16%, transparent);
  }

  .events-page__schedule-head {
    margin-bottom: 1rem;
    max-width: 40rem;
  }

  .events-page__schedule-head h3 {
    margin: 0.3rem 0 0.45rem;
    font-size: clamp(1.35rem, 2.6vw, 1.75rem);
  }

  .events-page__prep {
    margin: 0 0 1.25rem;
    padding: 1rem 1.15rem;
    max-width: 42rem;
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--green-light) 28%, white);
    border: 1px solid color-mix(in srgb, var(--green) 16%, transparent);
  }

  .events-page__prep ul {
    margin: 0.45rem 0 0;
    padding-left: 1.15rem;
    display: grid;
    gap: 0.4rem;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .events-page__past-head {
    max-width: 40rem;
    margin-bottom: 1.35rem;
  }

  .events-page__past-head h2 {
    margin: 0.3rem 0 0.5rem;
    font-size: clamp(1.7rem, 3vw, 2.25rem);
  }

  .events-page__past-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 2.5vw, 1.5rem);
  }

  @media (max-width: 900px) {
    .events-page__featured-head {
      grid-template-columns: 1fr;
    }

    .events-page__featured-photo {
      order: -1;
      max-width: 22rem;
    }

    .events-page__featured-photo img {
      max-height: 12rem;
    }
  }

  @media (max-width: 720px) {
    .events-page__past-grid {
      grid-template-columns: 1fr;
    }

    .events-page__actions {
      flex-direction: column;
      align-items: stretch;
    }

    .events-page__actions :global(.btn) {
      width: 100%;
      justify-content: center;
    }
  }
</style>
