---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/ui/Button.astro";
import ContactCta from "../components/layout/ContactCta.astro";
import { contestGuide } from "../content/contest";
import { upcomingAwards } from "../content/awards";
import { routes } from "../config/site";
import { asset } from "../lib/paths";

const jumps = [
  { href: "#overview", label: "Overview" },
  { href: "#eligibility", label: "Eligibility" },
  { href: "#categories", label: "Categories" },
  { href: "#dates", label: "Dates" },
  { href: "#submission", label: "Submit" },
  { href: "#criteria", label: "Criteria" },
  { href: "#contact", label: "Contact" },
];
---

<BaseLayout title={contestGuide.title} description={contestGuide.overview[0]}>
  <section class="section contest-hero">
    <div class="container contest-hero__layout" data-reveal data-reveal-y="20">
      <div class="contest-hero__copy">
        <img
          class="contest-hero__mark"
          src={asset("brandIcon")}
          alt=""
          width="56"
          height="56"
        />
        <p class="eyebrow">{contestGuide.programLine}</p>
        <h1>{contestGuide.title}</h1>
        <p class="contest-hero__draft">{contestGuide.draftLabel}</p>
        <p class="contest-hero__prize">{contestGuide.prizeLine}</p>
        <p class="contest-hero__lede">
          Nominate completed student AI projects from WNC high schools, community colleges,
          colleges, and universities—any discipline. Showcase at the BrainHub AI Summit,
          October 1, 2027.
        </p>
        <div class="contest-hero__actions">
          <Button href="#overview">Read guidelines</Button>
          <Button href={routes.november} variant="quiet">Nov 13 program →</Button>
          <Button href={routes.awards} variant="ghost">Past Awards →</Button>
        </div>
      </div>
      <figure class="contest-hero__figure">
        <img
          src={asset("contestHero")}
          alt="Speaker at the podium beside the brAIn Hub AI Summit banner"
          width="480"
          height="480"
        />
        <figcaption>brAIn Hub AI Summit · where winners present</figcaption>
      </figure>
    </div>
  </section>

  <nav class="contest-jump" aria-label="Guidelines sections">
    <div class="container">
      <ul class="contest-jump__list">
        {
          jumps.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>

  <section class="section section--tight" id="overview">
    <div class="container contest-block" data-reveal data-reveal-y="18">
      <p class="eyebrow">Overview</p>
      <h2>What this award recognizes</h2>
      {contestGuide.overview.map((para) => <p>{para}</p>)}
    </div>
  </section>

  <section class="section section--tight contest-alt" id="eligibility">
    <div class="container contest-block" data-reveal data-reveal-y="18">
      <p class="eyebrow">Eligibility &amp; scope</p>
      <h2>Who can enter</h2>
      <ul class="contest-defs">
        {
          contestGuide.eligibility.map((item) => (
            <li>
              <span class="contest-defs__label">{item.label}</span>
              <p>{item.text}</p>
            </li>
          ))
        }
      </ul>
      <details class="contest-counties">
        <summary>Eligible WNC counties ({contestGuide.counties.length})</summary>
        <p>{contestGuide.counties.join(" · ")}</p>
      </details>
    </div>
  </section>

  <section class="section section--tight" id="categories">
    <div class="container contest-block" data-reveal data-reveal-y="18">
      <p class="eyebrow">Award categories</p>
      <h2>Three $1,000 awards</h2>
      <p>{contestGuide.categoriesIntro}</p>
      <ul class="contest-cats">
        {
          contestGuide.categories.map((name) => (
            <li>
              <span class="contest-cats__amount">$1,000</span>
              <span class="contest-cats__name">{name}</span>
            </li>
          ))
        }
      </ul>
      <p class="contest-subhead">Evaluation areas</p>
      <p>Submissions should demonstrate:</p>
      <ul class="contest-bullets">
        {contestGuide.evaluationAreas.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <section class="section section--tight contest-alt" id="dates">
    <div class="container contest-block" data-reveal data-reveal-y="18">
      <p class="eyebrow">Important dates</p>
      <h2>Timeline</h2>
      <ol class="contest-dates">
        {
          contestGuide.dates.map((row) => (
            <li>
              <span class="contest-dates__when">{row.when}</span>
              <span class="contest-dates__what">{row.what}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section--tight" id="submission">
    <div class="container contest-block" data-reveal data-reveal-y="18">
      <p class="eyebrow">Submission requirements</p>
      <h2>What to submit</h2>
      <p>{contestGuide.submissionIntro}</p>
      <ul class="contest-defs">
        {
          contestGuide.submissionRequirements.map((item) => (
            <li>
              <span class="contest-defs__label">{item.label}</span>
              <p>{item.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--tight contest-alt" id="prizes">
    <div class="container contest-block" data-reveal data-reveal-y="18">
      <p class="eyebrow">Prizes &amp; recognition</p>
      <h2>What winners receive</h2>
      <p>{contestGuide.prizes}</p>
    </div>
  </section>

  <section class="section section--tight" id="criteria">
    <div class="container contest-block contest-block--wide" data-reveal data-reveal-y="18">
      <p class="eyebrow">Evaluation criteria</p>
      <h2>How submissions are judged</h2>
      <p>{contestGuide.criteriaIntro}</p>
      <div class="contest-table-wrap">
        <table class="contest-table">
          <thead>
            <tr>
              <th scope="col">Criterion</th>
              <th scope="col">Weight</th>
              <th scope="col">What judges look for</th>
            </tr>
          </thead>
          <tbody>
            {
              contestGuide.criteria.map((row) => (
                <tr>
                  <th scope="row">{row.name}</th>
                  <td>{row.weight}</td>
                  <td>{row.detail}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section section--tight contest-alt" id="contact">
    <div class="container contest-block" data-reveal data-reveal-y="18">
      <p class="eyebrow">Contact</p>
      <h2>Questions &amp; forms</h2>
      <p>
        Questions:{" "}
        <a href={`mailto:${contestGuide.contactEmail}`}>{contestGuide.contactEmail}</a>.
        Guidelines, the educator call for nominations, and required forms:{" "}
        <a href={contestGuide.formsUrl} target="_blank" rel="noopener noreferrer">
          www.brainhubsummit.com
        </a>
        .
      </p>
      {
        upcomingAwards.lead && (
          <p class="muted">
            Introduced at the November 13 Educators’ Exchange by {upcomingAwards.lead}.
          </p>
        )
      }
    </div>
  </section>

  <ContactCta description="Questions about the 2027 Student AI Innovator Award? Email Bill or write info@brainhub-contest.org." />
</BaseLayout>

<style>
  .contest-hero {
    background:
      linear-gradient(
        165deg,
        color-mix(in srgb, var(--green-light) 32%, var(--cream)),
        color-mix(in srgb, var(--cream) 88%, white)
      );
  }

  .contest-hero__layout {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(0, 0.55fr);
    gap: clamp(1.25rem, 4vw, 2.5rem);
    align-items: center;
  }

  .contest-hero__mark {
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 0.7rem;
    margin-bottom: 0.85rem;
  }

  .contest-hero h1 {
    margin: 0.35rem 0 0.5rem;
    font-size: clamp(2rem, 4.2vw, 2.85rem);
    max-width: 14ch;
    line-height: 1.12;
  }

  .contest-hero__draft {
    margin: 0 0 0.4rem;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--muted);
  }

  .contest-hero__prize {
    margin: 0 0 0.75rem;
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--green);
  }

  .contest-hero__lede {
    margin: 0;
    max-width: 36rem;
    color: var(--muted);
    font-size: 1.02rem;
    line-height: 1.5;
  }

  .contest-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem 0.85rem;
    margin-top: 1.25rem;
  }

  .contest-hero__figure {
    margin: 0;
    max-width: 16rem;
    justify-self: end;
    border-radius: var(--radius-md, 12px);
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--green) 14%, transparent);
    background: color-mix(in srgb, var(--green-light) 28%, white);
  }

  .contest-hero__figure img {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    object-position: center 40%;
  }

  .contest-hero__figure figcaption {
    padding: 0.4rem 0.6rem 0.5rem;
    font-size: 0.72rem;
    color: var(--muted);
    background: color-mix(in srgb, var(--white) 72%, transparent);
  }

  .contest-jump {
    position: sticky;
    top: var(--header-h, 3.5rem);
    z-index: 30;
    background: color-mix(in srgb, var(--cream) 92%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid color-mix(in srgb, var(--ink) 8%, transparent);
  }

  .contest-jump__list {
    list-style: none;
    margin: 0;
    padding: 0.65rem 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 0.35rem;
    row-gap: 0.35rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
  }

  .contest-jump__list li {
    display: inline-flex;
    align-items: center;
    flex: 0 0 auto;
  }

  .contest-jump__list li:not(:last-child)::after {
    content: "·";
    margin-left: 0.35rem;
    color: color-mix(in srgb, var(--muted) 70%, transparent);
    font-weight: 600;
  }

  .contest-jump__list a {
    display: inline-block;
    padding: 0.2rem 0.35rem;
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--muted);
    white-space: nowrap;
  }

  .contest-jump__list a:hover {
    color: var(--green);
  }

  .contest-alt {
    background: color-mix(in srgb, var(--cream) 72%, white);
  }

  .contest-block {
    max-width: 44rem;
  }

  .contest-block--wide {
    max-width: 56rem;
  }

  .contest-block h2 {
    margin: 0.3rem 0 0.85rem;
    font-size: clamp(1.55rem, 3vw, 2.05rem);
  }

  .contest-block > p {
    margin: 0 0 0.85rem;
    line-height: 1.55;
  }

  .contest-subhead {
    margin: 1.35rem 0 0.45rem;
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 600;
  }

  .contest-defs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.9rem;
  }

  .contest-defs li {
    padding: 0.95rem 1.05rem;
    border-radius: var(--radius-md, 12px);
    background: color-mix(in srgb, var(--white) 78%, var(--cream));
    border: 1px solid color-mix(in srgb, var(--ink) 7%, transparent);
  }

  .contest-defs__label {
    display: block;
    margin-bottom: 0.3rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--green);
  }

  .contest-defs p {
    margin: 0;
    font-size: 0.98rem;
    line-height: 1.5;
  }

  .contest-counties {
    margin-top: 1.15rem;
    padding: 0.85rem 1rem;
    border-radius: var(--radius-md, 12px);
    background: color-mix(in srgb, var(--white) 70%, var(--cream));
    border: 1px solid color-mix(in srgb, var(--ink) 7%, transparent);
  }

  .contest-counties summary {
    cursor: pointer;
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--ink);
  }

  .contest-counties p {
    margin: 0.65rem 0 0;
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--muted);
  }

  .contest-cats {
    list-style: none;
    margin: 0.95rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.65rem;
  }

  .contest-cats li {
    display: grid;
    gap: 0.25rem;
    padding: 0.9rem 0.95rem;
    border-radius: var(--radius-md, 12px);
    background: color-mix(in srgb, var(--green-light) 35%, white);
    border: 1px solid color-mix(in srgb, var(--green) 16%, transparent);
  }

  .contest-cats__amount {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--green);
  }

  .contest-cats__name {
    font-weight: 600;
    font-size: 0.98rem;
    line-height: 1.3;
  }

  .contest-bullets {
    margin: 0.35rem 0 0;
    padding-left: 1.2rem;
    display: grid;
    gap: 0.4rem;
  }

  .contest-bullets li {
    line-height: 1.45;
  }

  .contest-dates {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.65rem;
    border-left: 2px solid color-mix(in srgb, var(--green) 35%, transparent);
    padding-left: 1rem;
  }

  .contest-dates li {
    display: grid;
    gap: 0.15rem;
  }

  .contest-dates__when {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--green);
  }

  .contest-dates__what {
    font-size: 0.98rem;
    line-height: 1.45;
  }

  .contest-table-wrap {
    margin-top: 1rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    border-radius: var(--radius-md, 12px);
    border: 1px solid color-mix(in srgb, var(--ink) 8%, transparent);
    background: color-mix(in srgb, var(--white) 88%, var(--cream));
  }

  .contest-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.92rem;
  }

  .contest-table th,
  .contest-table td {
    padding: 0.75rem 0.9rem;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid color-mix(in srgb, var(--ink) 8%, transparent);
    line-height: 1.45;
  }

  .contest-table thead th {
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    background: color-mix(in srgb, var(--cream) 55%, white);
  }

  .contest-table tbody th {
    font-weight: 600;
    white-space: nowrap;
  }

  .contest-table tbody td:first-of-type {
    font-weight: 700;
    color: var(--green);
    white-space: nowrap;
  }

  .contest-table tr:last-child th,
  .contest-table tr:last-child td {
    border-bottom: 0;
  }

  .contest-block a {
    color: var(--blue);
    font-weight: 600;
  }

  @media (max-width: 900px) {
    .contest-hero__layout {
      grid-template-columns: 1fr;
    }

    .contest-hero__figure {
      max-width: 12rem;
      justify-self: start;
    }

    .contest-cats {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .contest-hero__actions {
      flex-direction: column;
      align-items: stretch;
    }

    .contest-hero__actions :global(.btn) {
      width: 100%;
      justify-content: center;
    }

    .contest-table tbody th {
      white-space: normal;
    }
  }
</style>
