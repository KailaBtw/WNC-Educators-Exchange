---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/ui/Button.astro";
import ContactCta from "../components/layout/ContactCta.astro";
import {
  awardsIntro,
  awardees,
  awardProfilePath,
} from "../content/awards";
import { routes } from "../config/site";
import { withBase } from "../lib/paths";
---

<BaseLayout
  title={awardsIntro.title}
  description="2026 BrAIn Hub Educator Award winners from Western North Carolina campuses."
>
  <section class="section awards-hero">
    <div class="container awards-hero__inner">
      <p class="eyebrow">{awardsIntro.eyebrow}</p>
      <h1>{awardsIntro.title}</h1>
      <p class="awards-hero__dek">{awardsIntro.description}</p>
      <div class="awards-hero__actions">
        <Button href={routes.contest} variant="ghost">2027 Student AI Innovator Award →</Button>
      </div>
    </div>
  </section>

  <section class="section awards-grid-section" id="winners">
    <div class="container">
      <div class="awards-grid">
        {
          awardees.map((person, index) => (
            <article
              class="award-card"
              data-reveal
              data-reveal-delay={String(0.05 * (index % 3))}
              data-reveal-y="28"
              style={`--accent: ${index % 3 === 0 ? "var(--purple)" : index % 3 === 1 ? "var(--blue)" : "var(--green)"}`}
            >
              <a class="award-card__media" href={withBase(awardProfilePath(person.id))}>
                <img
                  src={person.image}
                  alt={person.imageAlt}
                  style={person.imagePosition ? `object-position: ${person.imagePosition}` : undefined}
                />
                <span class="award-card__year">{person.year}</span>
              </a>
              <div class="award-card__body">
                <p class="award-card__stance">{person.stance}</p>
                <h2>
                  <a href={withBase(awardProfilePath(person.id))}>{person.name}</a>
                </h2>
                <p class="award-card__institution">{person.institution}</p>
                <p class="award-card__recognition">{person.recognition}</p>
                <p class="award-card__category">{person.category}</p>
                <p class="award-card__summary">{person.summary}</p>
                <div class="award-card__focus">
                  {person.focus.map((item) => (
                    <span>{item}</span>
                  ))}
                </div>
                <div class="award-card__actions">
                  <Button href={awardProfilePath(person.id)} variant="quiet">
                    View profile →
                  </Button>
                  {
                    person.certificateUrl && (
                      <Button href={person.certificateUrl} variant="ghost" external>
                        Certificate
                      </Button>
                    )
                  }
                  {
                    person.slidesPdf && (
                      <Button href={person.slidesPdf} variant="ghost" external>
                        Download slides
                      </Button>
                    )
                  }
                  {
                    person.proposalPdf && (
                      <Button href={person.proposalPdf} variant="ghost" external>
                        Download proposal
                      </Button>
                    )
                  }
                  {
                    person.pendingMedia && !person.certificateUrl && (
                      <span class="award-card__pending">Portrait &amp; materials forthcoming</span>
                    )
                  }
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <ContactCta
    title="Know an educator who should be here?"
    description="Send a note about faculty doing careful AI work on your campus—we will follow up."
  />
</BaseLayout>

<style>
  .awards-hero__inner {
    max-width: 42rem;
  }

  .awards-hero h1 {
    font-size: clamp(2.1rem, 4.5vw, 3.1rem);
    margin: 0.4rem 0 0.85rem;
    max-width: 22ch;
  }

  .awards-hero__dek {
    margin: 0;
    color: var(--muted);
    font-size: 1.08rem;
  }

  .awards-hero__actions {
    margin-top: 1.1rem;
  }

  .awards-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(0.75rem, 1.8vw, 1.1rem);
    max-width: 52rem;
  }

  .award-card {
    --accent: var(--purple);
    display: grid;
    grid-template-rows: auto 1fr;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: color-mix(in srgb, var(--white) 88%, var(--cream));
    border: 1px solid color-mix(in srgb, var(--ink) 7%, transparent);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .award-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 14px 36px color-mix(in srgb, var(--ink) 8%, transparent);
  }

  .award-card__media {
    position: relative;
    display: block;
    aspect-ratio: 5 / 4;
    overflow: hidden;
    background: color-mix(in srgb, var(--green-light) 30%, white);
  }

  .award-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
    transition: transform 0.35s ease;
  }

  .award-card:hover .award-card__media img {
    transform: scale(1.015);
  }

  .award-card__year {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--ink) 72%, transparent);
    color: white;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .award-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.7rem 0.8rem 0.85rem;
  }

  .award-card__stance {
    margin: 0;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--accent);
  }

  .award-card h2 {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.2;
  }

  .award-card h2 a {
    color: inherit;
    text-decoration: none;
  }

  .award-card h2 a:hover {
    color: var(--accent);
  }

  .award-card__institution {
    margin: 0;
    font-size: 0.92rem;
    color: var(--muted);
  }

  .award-card__recognition {
    margin: 0.15rem 0 0;
    font-size: 0.88rem;
    font-weight: 600;
  }

  .award-card__category {
    margin: 0;
    display: inline-block;
    align-self: start;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 600;
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    color: var(--accent);
  }

  .award-card__summary {
    margin: 0.25rem 0 0;
    font-size: 0.85rem;
    color: var(--muted);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .award-card__focus {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.5rem;
  }

  .award-card__focus span {
    font-size: 0.72rem;
    padding: 0.2rem 0.45rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--ink) 5%, transparent);
    color: var(--muted);
  }

  .award-card__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: auto;
    padding-top: 0.85rem;
  }

  .award-card__pending {
    font-size: 0.82rem;
    color: var(--muted);
    align-self: center;
  }

  @media (max-width: 768px) {
    .awards-grid {
      grid-template-columns: 1fr;
      max-width: none;
    }

    .award-card__media {
      aspect-ratio: 5 / 4;
    }
  }
</style>
