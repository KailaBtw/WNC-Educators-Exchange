---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/ui/Button.astro";
import ContactCta from "../components/layout/ContactCta.astro";
import {
  awardsIntro,
  awardees,
  awardProfilePath,
} from "../content/awards";
import { routes } from "../config/site";
import { withBase } from "../lib/paths";
---

<BaseLayout
  title={awardsIntro.title}
  description="2026 BrAIn Hub Educator Award winners from Western North Carolina campuses."
>
  <section class="section awards-hero">
    <div class="container awards-hero__inner">
      <p class="eyebrow">{awardsIntro.eyebrow}</p>
      <h1>{awardsIntro.title}</h1>
      <p class="awards-hero__dek">{awardsIntro.description}</p>
      <div class="awards-hero__actions">
        <Button href={routes.contest} variant="ghost">2027 Student AI Innovator Award →</Button>
      </div>
    </div>
  </section>

  <section class="section awards-grid-section" id="winners">
    <div class="container">
      <ul class="awards-list">
        {
          awardees.map((person, index) => (
            <li
              class="award-row"
              data-reveal
              data-reveal-delay={String(0.03 * (index % 3))}
              data-reveal-y="16"
              style={`--accent: ${index % 3 === 0 ? "var(--purple)" : index % 3 === 1 ? "var(--blue)" : "var(--green)"}`}
            >
              <a class="award-row__media" href={withBase(awardProfilePath(person.id))}>
                <img
                  src={person.image}
                  alt={person.imageAlt}
                  width="160"
                  height="160"
                  loading="lazy"
                />
              </a>
              <div class="award-row__body">
                <p class="award-row__meta">
                  <span>{person.year}</span>
                  <span aria-hidden="true">·</span>
                  <span>{person.category}</span>
                </p>
                <h2>
                  <a href={withBase(awardProfilePath(person.id))}>{person.name}</a>
                </h2>
                <p class="award-row__institution">{person.institution}</p>
                <p class="award-row__summary">{person.summary}</p>
                <div class="award-row__actions">
                  <Button href={awardProfilePath(person.id)} variant="quiet">
                    View profile →
                  </Button>
                  {
                    person.certificateUrl && (
                      <Button href={person.certificateUrl} variant="ghost" external>
                        Certificate
                      </Button>
                    )
                  }
                </div>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <ContactCta
    title="Know an educator who should be here?"
    description="Send a note about faculty doing careful AI work on your campus—we will follow up."
  />
</BaseLayout>

<style>
  .awards-hero__inner {
    max-width: 42rem;
  }

  .awards-hero h1 {
    font-size: clamp(1.95rem, 4vw, 2.75rem);
    margin: 0.35rem 0 0.7rem;
    max-width: 22ch;
  }

  .awards-hero__dek {
    margin: 0;
    color: var(--muted);
    font-size: 1.02rem;
  }

  .awards-hero__actions {
    margin-top: 0.95rem;
  }

  .awards-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
    max-width: 46rem;
  }

  .award-row {
    --accent: var(--purple);
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
    padding: 0.85rem;
    border-radius: var(--radius-md, 12px);
    background: color-mix(in srgb, var(--white) 88%, var(--cream));
    border: 1px solid color-mix(in srgb, var(--ink) 7%, transparent);
  }

  .award-row:hover {
    border-color: color-mix(in srgb, var(--accent) 26%, transparent);
  }

  .award-row__media {
    display: block;
    width: 8.5rem;
    height: 8.5rem;
    border-radius: 0.85rem;
    overflow: hidden;
    background: color-mix(in srgb, var(--green-light) 22%, white);
    flex-shrink: 0;
  }

  .award-row__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
    display: block;
  }

  .award-row__body {
    min-width: 0;
  }

  .award-row__meta {
    margin: 0 0 0.2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .award-row h2 {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.2;
  }

  .award-row h2 a {
    color: inherit;
    text-decoration: none;
  }

  .award-row h2 a:hover {
    color: var(--accent);
  }

  .award-row__institution {
    margin: 0.2rem 0 0;
    font-size: 0.88rem;
    color: var(--muted);
    line-height: 1.35;
  }

  .award-row__summary {
    margin: 0.4rem 0 0;
    font-size: 0.86rem;
    color: var(--muted);
    line-height: 1.45;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .award-row__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.55rem;
  }

  @media (max-width: 520px) {
    .award-row {
      grid-template-columns: 6.5rem minmax(0, 1fr);
      gap: 0.75rem;
      padding: 0.7rem;
    }

    .award-row__media {
      width: 6.5rem;
      height: 6.5rem;
      border-radius: 0.7rem;
    }
  }
</style>
