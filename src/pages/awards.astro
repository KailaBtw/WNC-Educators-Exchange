---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/ui/Button.astro";
import ContactCta from "../components/layout/ContactCta.astro";
import { awardsIntro, awardees } from "../content/awards";
import { site } from "../content/site";

const featured = awardees[0];
const rest = awardees.slice(1);
---

<BaseLayout
  title="Faculty Awards"
  description="Faculty we recognize—educators shaping responsible AI practice across Western North Carolina."
>
  <section class="section awards-hero">
    <div class="container awards-hero__inner">
      <p class="eyebrow">{awardsIntro.eyebrow}</p>
      <h1>{awardsIntro.title}</h1>
      <p class="awards-hero__dek">{awardsIntro.description}</p>
    </div>
  </section>

  {
    featured && (
      <section class="section section--tight awards-featured">
        <div class="container">
          <article class="awards-spotlight" data-reveal data-reveal-y="28">
            <div class="awards-spotlight__media">
              <img src={featured.image} alt={featured.imageAlt} />
              <span class="awards-spotlight__year">{featured.year}</span>
            </div>
            <div class="awards-spotlight__body">
              <p class="awards-spotlight__stance">{featured.stance}</p>
              <h2>{featured.name}</h2>
              <p class="awards-spotlight__institution">{featured.institution}</p>
              <p class="awards-spotlight__recognition">{featured.recognition}</p>
              <p class="awards-spotlight__category">{featured.category}</p>
              <p class="awards-spotlight__summary">{featured.summary}</p>
              <ul class="awards-spotlight__focus">
                {featured.focus.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          </article>
        </div>
      </section>
    )
  }

  <section class="section awards-grid-section">
    <div class="container">
      <div class="awards-grid-head">
        <p class="eyebrow">Honorees</p>
        <h2>More faculty shaping the work</h2>
      </div>

      <div class="awards-grid">
        {
          rest.map((person, index) => (
            <article
              class="award-card"
              data-reveal
              data-reveal-delay={String(0.05 * (index % 3))}
              data-reveal-y="28"
              style={`--accent: ${index % 3 === 0 ? "var(--purple)" : index % 3 === 1 ? "var(--blue)" : "var(--green)"}`}
            >
              <div class="award-card__media">
                <img src={person.image} alt={person.imageAlt} />
              </div>
              <div class="award-card__body">
                <p class="award-card__stance">{person.stance}</p>
                <h3>{person.name}</h3>
                <p class="award-card__institution">{person.institution}</p>
                <p class="award-card__recognition">{person.recognition}</p>
                <p class="award-card__category">{person.category}</p>
                <p class="award-card__summary">{person.summary}</p>
                <div class="award-card__focus">
                  {person.focus.map((item) => (
                    <span>{item}</span>
                  ))}
                </div>
              </div>
            </article>
          ))
        }
      </div>

      <div class="awards-archive">
        <div>
          <h2>Full awards archive</h2>
          <p>
            Photos, citations, and additional materials live in the shared Drive folder. Swap in real
            portraits here when those files are ready.
          </p>
        </div>
        <Button href={site.awardsDriveUrl} external>Open awards archive</Button>
      </div>
    </div>
  </section>

  <ContactCta
    title="Know an educator who should be here?"
    description="Send a note about faculty doing careful AI work on your campus—we will follow up."
  />
</BaseLayout>

<style>
  .awards-hero__inner {
    max-width: 40rem;
  }

  .awards-hero h1 {
    font-size: clamp(2.3rem, 5vw, 3.35rem);
    margin: 0.4rem 0 0.85rem;
    max-width: 14ch;
  }

  .awards-hero__dek {
    margin: 0;
    color: var(--muted);
    font-size: 1.08rem;
  }

  .awards-featured {
    background: color-mix(in srgb, var(--purple) 7%, var(--cream));
  }

  .awards-spotlight {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(1.25rem, 3vw, 2.25rem);
    align-items: center;
  }

  .awards-spotlight__media {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    aspect-ratio: 4 / 5;
    max-width: 22rem;
    background: color-mix(in srgb, var(--green-light) 35%, white);
  }

  .awards-spotlight__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .awards-spotlight__year {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    padding: 0.45rem 0.75rem;
    border-radius: 0.7rem;
    background: color-mix(in srgb, var(--cream) 92%, white);
    color: var(--purple);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .awards-spotlight__stance {
    margin: 0;
    color: var(--purple);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 700;
  }

  .awards-spotlight h2 {
    margin: 0.4rem 0 0.35rem;
    font-size: clamp(1.9rem, 3.5vw, 2.5rem);
  }

  .awards-spotlight__institution {
    margin: 0;
    color: var(--blue);
    font-weight: 600;
  }

  .awards-spotlight__recognition {
    margin: 0.35rem 0 0;
    color: var(--green);
    font-weight: 600;
  }

  .awards-spotlight__category {
    margin: 0.35rem 0 0;
    display: inline-flex;
    width: fit-content;
    padding: 0.22rem 0.55rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--blue) 14%, white);
    color: var(--blue);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .awards-spotlight__summary {
    margin: 0.85rem 0 0;
    color: var(--muted);
    max-width: 36rem;
  }

  .awards-spotlight__focus {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .awards-spotlight__focus li {
    font-size: 0.78rem;
    font-weight: 600;
    padding: 0.3rem 0.65rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--purple) 12%, white);
    color: var(--ink);
  }

  .awards-grid-head {
    margin-bottom: 1.35rem;
  }

  .awards-grid-head h2 {
    margin: 0.35rem 0 0;
    font-size: clamp(1.6rem, 3vw, 2rem);
  }

  .awards-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.15rem, 2.5vw, 1.6rem);
  }

  .award-card {
    --accent: var(--purple);
    display: flex;
    flex-direction: column;
    min-height: 100%;
    padding: 0.85rem;
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--white) 70%, var(--cream));
    border: 1px solid color-mix(in srgb, var(--purple) 10%, transparent);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .award-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 14px 30px color-mix(in srgb, var(--ink) 8%, transparent);
  }

  .award-card__media {
    border-radius: calc(var(--radius-lg) - 0.35rem);
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: color-mix(in srgb, var(--green-light) 35%, white);
  }

  .award-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.45s ease;
  }

  .award-card:hover .award-card__media img {
    transform: scale(1.04);
  }

  .award-card__body {
    display: grid;
    gap: 0.3rem;
    padding: 0.95rem 0.25rem 0.35rem;
    flex: 1;
  }

  .award-card__stance {
    margin: 0;
    color: var(--accent);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 700;
  }

  .award-card h3 {
    margin: 0;
    font-size: clamp(1.25rem, 2.2vw, 1.45rem);
    line-height: 1.2;
  }

  .award-card__institution {
    margin: 0;
    color: var(--blue);
    font-size: 0.9rem;
    font-weight: 600;
  }

  .award-card__recognition {
    margin: 0.1rem 0 0;
    color: var(--green);
    font-size: 0.86rem;
    font-weight: 600;
  }

  .award-card__category {
    margin: 0.25rem 0 0;
    display: inline-flex;
    width: fit-content;
    padding: 0.2rem 0.5rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--blue) 12%, white);
    color: var(--blue);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .award-card__summary {
    margin: 0.4rem 0 0;
    color: var(--muted);
    font-size: 0.92rem;
  }

  .award-card__focus {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin-top: 0.75rem;
  }

  .award-card__focus span {
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.22rem 0.5rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent) 12%, white);
    color: var(--ink);
  }

  .awards-archive {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    padding: 1.5rem;
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--green-light) 22%, var(--cream));
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .awards-archive h2 {
    margin: 0 0 0.4rem;
    font-size: 1.45rem;
  }

  .awards-archive p {
    margin: 0;
    color: var(--muted);
    max-width: 34rem;
  }

  @media (max-width: 960px) {
    .awards-spotlight {
      grid-template-columns: 1fr;
    }

    .awards-spotlight__media {
      max-width: 18rem;
      margin-inline: auto;
    }

    .awards-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .awards-grid {
      grid-template-columns: 1fr;
      max-width: 22rem;
      margin-inline: auto;
    }
  }
</style>
