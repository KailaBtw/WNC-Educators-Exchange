---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/ui/Button.astro";
import ContactCta from "../components/layout/ContactCta.astro";
import { awardsIntro, awardees, awardProfilePath } from "../content/awards";
import { withBase } from "../lib/paths";
---

<BaseLayout
  title="Faculty we recognize"
  description="2026 faculty excellence awards—educators shaping responsible AI practice across Western North Carolina."
>
  <section class="section awards-hero">
    <div class="container awards-hero__inner">
      <p class="eyebrow">{awardsIntro.eyebrow}</p>
      <h1>{awardsIntro.title}</h1>
      <p class="awards-hero__dek">{awardsIntro.description}</p>
    </div>
  </section>

  <section class="section awards-grid-section">
    <div class="container">
      <div class="awards-grid">
        {
          awardees.map((person, index) => (
            <article
              class="award-card"
              data-reveal
              data-reveal-delay={String(0.05 * (index % 3))}
              data-reveal-y="28"
              style={`--accent: ${index % 3 === 0 ? "var(--purple)" : index % 3 === 1 ? "var(--blue)" : "var(--green)"}`}
            >
              <a class="award-card__media" href={withBase(awardProfilePath(person.id))}>
                <img src={person.image} alt={person.imageAlt} />
                <span class="award-card__year">{person.year}</span>
              </a>
              <div class="award-card__body">
                <p class="award-card__stance">{person.stance}</p>
                <h2>
                  <a href={withBase(awardProfilePath(person.id))}>{person.name}</a>
                </h2>
                <p class="award-card__institution">{person.institution}</p>
                <p class="award-card__recognition">{person.recognition}</p>
                <p class="award-card__category">{person.category}</p>
                <p class="award-card__summary">{person.summary}</p>
                <div class="award-card__focus">
                  {person.focus.map((item) => (
                    <span>{item}</span>
                  ))}
                </div>
                <div class="award-card__actions">
                  <Button href={awardProfilePath(person.id)} variant="quiet">
                    View profile →
                  </Button>
                  {
                    person.slidesPdf && (
                      <Button href={person.slidesPdf} variant="ghost" external>
                        Download slides
                      </Button>
                    )
                  }
                  {
                    person.proposalPdf && (
                      <Button href={person.proposalPdf} variant="ghost" external>
                        Download proposal
                      </Button>
                    )
                  }
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <ContactCta
    title="Know an educator who should be here?"
    description="Send a note about faculty doing careful AI work on your campus—we will follow up."
  />
</BaseLayout>

<style>
  .awards-hero__inner {
    max-width: 40rem;
  }

  .awards-hero h1 {
    font-size: clamp(2.3rem, 5vw, 3.35rem);
    margin: 0.4rem 0 0.85rem;
    max-width: 16ch;
  }

  .awards-hero__dek {
    margin: 0;
    color: var(--muted);
    font-size: 1.08rem;
  }

  .awards-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.15rem, 2.5vw, 1.75rem);
  }

  .award-card {
    --accent: var(--purple);
    display: flex;
    flex-direction: column;
    min-height: 100%;
    padding: 0.85rem;
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--white) 70%, var(--cream));
    border: 1px solid color-mix(in srgb, var(--purple) 10%, transparent);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .award-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 14px 30px color-mix(in srgb, var(--ink) 8%, transparent);
  }

  .award-card__media {
    position: relative;
    display: block;
    border-radius: calc(var(--radius-lg) - 0.35rem);
    overflow: hidden;
    aspect-ratio: 4 / 5;
    max-height: 18rem;
    background: color-mix(in srgb, var(--green-light) 35%, white);
  }

  .award-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.45s ease;
  }

  .award-card:hover .award-card__media img {
    transform: scale(1.04);
  }

  .award-card__year {
    position: absolute;
    left: 0.75rem;
    bottom: 0.75rem;
    padding: 0.3rem 0.55rem;
    border-radius: 0.55rem;
    background: color-mix(in srgb, var(--cream) 92%, white);
    color: var(--accent);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .award-card__body {
    display: grid;
    gap: 0.3rem;
    padding: 0.95rem 0.25rem 0.35rem;
    flex: 1;
  }

  .award-card__stance {
    margin: 0;
    color: var(--accent);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 700;
  }

  .award-card h2 {
    margin: 0;
    font-size: clamp(1.25rem, 2.2vw, 1.5rem);
    line-height: 1.2;
  }

  .award-card h2 a {
    color: inherit;
    text-decoration: none;
  }

  .award-card h2 a:hover {
    color: var(--purple);
  }

  .award-card__institution {
    margin: 0;
    color: var(--blue);
    font-size: 0.9rem;
    font-weight: 600;
  }

  .award-card__recognition {
    margin: 0.1rem 0 0;
    color: var(--green);
    font-size: 0.86rem;
    font-weight: 600;
  }

  .award-card__category {
    margin: 0.25rem 0 0;
    display: inline-flex;
    width: fit-content;
    padding: 0.2rem 0.5rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--blue) 12%, white);
    color: var(--blue);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .award-card__summary {
    margin: 0.4rem 0 0;
    color: var(--muted);
    font-size: 0.92rem;
  }

  .award-card__focus {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin-top: 0.75rem;
  }

  .award-card__focus span {
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.22rem 0.5rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent) 12%, white);
    color: var(--ink);
  }

  .award-card__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.85rem;
    align-items: center;
    margin-top: 0.85rem;
  }

  @media (max-width: 800px) {
    .awards-grid {
      grid-template-columns: 1fr;
      max-width: 26rem;
      margin-inline: auto;
    }

    .award-card__media {
      max-height: none;
    }
  }
</style>
