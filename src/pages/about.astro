---
import BaseLayout from "../layouts/BaseLayout.astro";
import StatRow from "../components/ui/StatRow.astro";
import Button from "../components/ui/Button.astro";
import ContactCta from "../components/layout/ContactCta.astro";
import { site, surveyAttribution } from "../content/site";
import { stats } from "../content/stats";
import { summitCommittee } from "../content/committee";
import { assets, routes } from "../config/site";
import { asset, withBase } from "../lib/paths";
---

<BaseLayout
  title="About"
  description="About the WNC Educators Exchange: Brain Hub initiatives, Land of Sky support, and the Top 10 Issues report."
>
  <section class="section">
    <div class="container about-page">
      <div class="about-page__images" aria-hidden="true">
        <div class="about-page__img about-page__img--a"></div>
        <div class="about-page__img about-page__img--b"></div>
      </div>
      <div class="about-page__copy">
        <p class="eyebrow">About</p>
        <h1>Why this exchange exists</h1>
        <div class="prose muted">
          <p>
            Artificial intelligence has arrived in WNC classrooms whether educators are ready for it
            or not. The Exchange exists so faculty, staff, and campus leaders do not have to navigate
            that shift alone.
          </p>
          <p>
            {site.brainHubBlurb} With support from the {site.org}, we convene regional summits,
            publish findings from the educator survey, and keep a shared record of what is working—and
            what still needs institutional commitment. The November 13 Exchange at Mars Hill University
            continues that work.
          </p>
          <p>
            Physical colleges still provide community and place. Online tools extend access. Neither
            replaces the other, and neither absolves us of teaching students to think before they
            outsource the work. Brain first, then AI.
          </p>
        </div>
        <StatRow stats={stats.aboutTeaser} />
        <p class="about-page__survey muted">{surveyAttribution.blurb}</p>
        <div class="about-page__actions">
          <Button href={routes.november}>November 13 event</Button>
          <Button href={routes.issues} variant="ghost">Read the Top 10 →</Button>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--tight about-survey">
    <div class="container about-survey__inner">
      <p class="eyebrow">Survey source</p>
      <h2>{surveyAttribution.name}</h2>
      <p class="muted">
        Fielded {surveyAttribution.when} · {surveyAttribution.respondents}. The “54” figures you see
        across this site are those respondents—not a national dataset. Campus practice cards on the
        Schools page draw from the same survey writeups (Leigha Travis).
      </p>
    </div>
  </section>

  <section class="section section--tight about-partners">
    <div class="container">
      <p class="eyebrow">Partners</p>
      <h2>Brain Hub &amp; Land of Sky</h2>
      <p class="muted about-partners__lede">
        The Educators Exchange sits inside the 2026 Brain Hub initiatives and is organized with
        support from the {site.org}. Official logos will replace these wordmarks when files arrive.
      </p>
      <div class="about-partners__logos">
        <a class="about-partners__logo" href={withBase(routes.brainHub)}>
          <img src={asset(assets.logoBrainHub)} alt={`${site.brainHubName} wordmark`} width="320" height="80" />
        </a>
        <div class="about-partners__logo">
          <img
            src={asset(assets.logoLandOfSky)}
            alt={`${site.org} wordmark`}
            width="420"
            height="80"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="section about-committee">
    <div class="container">
      <p class="eyebrow">November 13</p>
      <h2>{summitCommittee.title}</h2>
      <p class="muted about-committee__lede">
        Host, presenters, sponsoring campuses, interns, and Land of Sky partners for the Educators
        Exchange at Mars Hill University.
      </p>

      <div class="about-committee__groups">
        {
          summitCommittee.groups.map((group) => (
            <div class="about-committee__group">
              <h3>{group.title}</h3>
              <ul>
                {group.people.map((person) => (
                  <li>
                    <strong>{person.name}</strong>
                    <span class="about-committee__org">{person.org}</span>
                    <a href={`mailto:${person.email}`}>{person.email}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>

      <p class="about-committee__chair">
        <strong>Chair:</strong> {summitCommittee.chair.name}
        {" · "}
        <a href={`mailto:${summitCommittee.chair.email}`}>{summitCommittee.chair.email}</a>
      </p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container about-authors">
      <p class="eyebrow">Report authors</p>
      <h2>Created by</h2>
      <div class="about-authors__grid">
        {
          site.authors.map((author) => (
            <figure>
              <img src={author.image} alt={author.name} />
              <figcaption>
                <strong>{author.name}</strong>
                <span>{author.role}</span>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <ContactCta />
</BaseLayout>

<style>
  .about-page {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.75rem, 4vw, 3rem);
    align-items: center;
  }

  .about-page__images {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    align-items: stretch;
  }

  .about-page__img {
    border-radius: var(--radius-lg);
    aspect-ratio: 3 / 4;
    min-height: 0;
    background-size: cover;
    background-position: center;
  }

  .about-page__img--a {
    background-image: var(--asset-about-story-1);
  }

  .about-page__img--b {
    background-image: var(--asset-about-story-2);
  }

  .about-page h1 {
    font-size: clamp(2.2rem, 4.5vw, 3rem);
    margin: 0.4rem 0 0.9rem;
  }

  .about-page__survey {
    margin: 1rem 0 0;
    max-width: 40rem;
    font-size: 0.95rem;
  }

  .about-page__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  .about-survey {
    background: color-mix(in srgb, var(--green-light) 22%, var(--cream));
  }

  .about-survey__inner {
    max-width: 42rem;
  }

  .about-survey h2 {
    margin: 0.35rem 0 0.65rem;
    font-size: clamp(1.45rem, 2.8vw, 1.85rem);
  }

  .about-partners {
    background: color-mix(in srgb, var(--purple) 6%, var(--cream));
  }

  .about-partners h2 {
    margin: 0.35rem 0 0.65rem;
    font-size: clamp(1.6rem, 3vw, 2rem);
  }

  .about-partners__lede {
    max-width: 40rem;
    margin: 0 0 1.35rem;
  }

  .about-partners__logos {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
  }

  .about-partners__logo {
    display: block;
    max-width: min(100%, 22rem);
    border-radius: var(--radius-lg);
    overflow: hidden;
    text-decoration: none;
  }

  .about-partners__logo img {
    width: 100%;
    height: auto;
    display: block;
  }

  .about-committee h2 {
    margin: 0.35rem 0 0.55rem;
    font-size: clamp(1.5rem, 3vw, 2rem);
    max-width: 28ch;
  }

  .about-committee__lede {
    max-width: 40rem;
    margin: 0 0 1.5rem;
  }

  .about-committee__groups {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.25rem, 3vw, 1.85rem);
  }

  .about-committee__group h3 {
    margin: 0 0 0.65rem;
    font-size: 0.95rem;
    color: var(--green);
  }

  .about-committee__group ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }

  .about-committee__group li {
    display: grid;
    gap: 0.1rem;
  }

  .about-committee__org {
    color: var(--muted);
    font-size: 0.88rem;
  }

  .about-committee__group a {
    color: var(--blue);
    font-size: 0.88rem;
    word-break: break-word;
  }

  .about-committee__chair {
    margin: 1.75rem 0 0;
    padding-top: 1.15rem;
    border-top: 1px solid color-mix(in srgb, var(--ink) 10%, transparent);
    font-size: 1.02rem;
  }

  .about-committee__chair a {
    color: var(--blue);
  }

  .about-authors h2 {
    margin: 0.35rem 0 1.15rem;
    font-size: clamp(1.6rem, 3vw, 2rem);
  }

  .about-authors__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 14rem));
    gap: 1.25rem;
  }

  .about-authors__grid figure {
    margin: 0;
  }

  .about-authors__grid img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--green-light) 30%, white);
  }

  .about-authors__grid figcaption {
    display: grid;
    gap: 0.15rem;
    margin-top: 0.65rem;
  }

  .about-authors__grid span {
    color: var(--muted);
    font-size: 0.9rem;
  }

  @media (max-width: 800px) {
    .about-page {
      grid-template-columns: 1fr;
    }

    .about-page__images {
      max-width: 22rem;
      margin-inline: auto;
    }

    .about-committee__groups {
      grid-template-columns: 1fr;
    }

    .about-authors__grid {
      grid-template-columns: 1fr 1fr;
      max-width: 28rem;
    }
  }
</style>
