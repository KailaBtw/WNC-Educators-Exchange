---
import BaseLayout from "../layouts/BaseLayout.astro";
import StatRow from "../components/ui/StatRow.astro";
import Button from "../components/ui/Button.astro";
import ContactCta from "../components/layout/ContactCta.astro";
import { site, surveyAttribution } from "../content/site";
import { stats } from "../content/stats";
import { summitCommittee } from "../content/committee";
import { assets, routes } from "../config/site";
import { asset, withBase } from "../lib/paths";
---

<BaseLayout
  title="About"
  description="About the WNC Educators Exchange: Brain Hub initiatives, Land of Sky support, and the Top 10 Issues report."
>
  <section class="section">
    <div class="container about-page">
      <div class="about-page__copy">
        <p class="eyebrow">About</p>
        <h1>Educators Exchanging Ideas about A.I.</h1>
        <div class="prose muted">
          <p>
            Artificial intelligence has arrived in WNC classrooms whether educators are ready for it
            or not. The Exchange exists so faculty, staff, and campus leaders do not have to navigate
            that shift alone.
          </p>
          <p>
            {site.brainHubBlurb} With support from the {site.org}, we convene regional summits,
            publish findings from the educator survey, and keep a shared record of what is working—and
            what still needs institutional commitment. The November 13 Exchange at Mars Hill University
            continues that work.
          </p>
          <p>
            Physical colleges still provide community and place. Online tools extend access. Neither
            replaces the other, and neither absolves us of teaching students to think before they
            outsource the work. Brain first, then AI.
          </p>
        </div>
        <StatRow stats={stats.aboutTeaser} />
        <p class="about-page__survey muted">{surveyAttribution.blurb}</p>
        <div class="about-page__actions">
          <Button href={routes.november}>November 13 event</Button>
          <Button href={routes.issues} variant="ghost">Read the Top 10 →</Button>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--tight about-survey">
    <div class="container about-survey__inner">
      <p class="eyebrow">Survey source</p>
      <h2>{surveyAttribution.name}</h2>
      <p class="muted">
        In {surveyAttribution.when} we surveyed {surveyAttribution.respondents}. Every “54” on this
        site is that group. The campus practice cards on the Schools page come from Leigha Travis’s
        writeups of their answers.
      </p>
    </div>
  </section>

  <section class="section section--tight about-partners">
    <div class="container">
      <p class="eyebrow">Partners</p>
      <h2>Brain Hub &amp; Land of Sky</h2>
      <p class="muted about-partners__lede">
        The Educators Exchange sits inside the 2026 Brain Hub initiatives and is organized with
        support from the {site.org}.
      </p>
      <div class="about-partners__logos">
        <a class="about-partners__logo about-partners__logo--brain" href={withBase(routes.brainHub)}>
          <img src={asset(assets.logoBrainHub)} alt={`${site.brainHubName} logo`} width="320" height="320" />
        </a>
        <div class="about-partners__logo about-partners__logo--sky">
          <img
            src={asset(assets.logoLandOfSky)}
            alt={`${site.org} logo`}
            width="420"
            height="160"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="section about-committee">
    <div class="container">
      <p class="eyebrow">November 13</p>
      <h2>{summitCommittee.title}</h2>
      <p class="muted about-committee__lede">
        Host, presenters, sponsoring campuses, interns, and Land of Sky partners for the Educators
        Exchange at Mars Hill University.
      </p>

      <article class="about-person-card about-person-card--featured">
        <img
          class="about-person-card__photo"
          src={asset(assets.teamChrisCain)}
          alt="Chris Cain, Mars Hill University"
          width="96"
          height="96"
        />
        <div class="about-person-card__body">
          <p class="about-person-card__role">Host</p>
          <h3>Chris Cain</h3>
          <p class="about-person-card__org">Mars Hill University</p>
          <a class="about-person-card__email" href="mailto:ccain@mhu.edu">ccain@mhu.edu</a>
        </div>
      </article>

      <div class="about-committee__groups">
        {
          summitCommittee.groups
            .filter((group) => group.id !== "host")
            .map((group) => (
              <div class="about-committee__group">
                <h3>{group.title}</h3>
                <div class="about-person-grid">
                  {group.people.map((person) => (
                    <article class="about-person-card">
                      <div class="about-person-card__body">
                        <h4>{person.name}</h4>
                        <p class="about-person-card__org">{person.org}</p>
                        <a class="about-person-card__email" href={`mailto:${person.email}`}>
                          {person.email}
                        </a>
                      </div>
                    </article>
                  ))}
                </div>
              </div>
            ))
        }
      </div>

      <article class="about-person-card about-person-card--chair">
        <div class="about-person-card__body">
          <p class="about-person-card__role">Chair</p>
          <h3>{summitCommittee.chair.name}</h3>
          <p class="about-person-card__org">WNC Educators Exchange</p>
          <a class="about-person-card__email" href={`mailto:${summitCommittee.chair.email}`}>
            {summitCommittee.chair.email}
          </a>
        </div>
      </article>

      <div class="about-committee__group about-committee__group--site">
        <h3>Website developer</h3>
        <div class="about-person-grid">
          <article class="about-person-card about-person-card--site">
            <div class="about-person-card__body">
              <h4>Ellie LaGrave</h4>
              <p class="about-person-card__org">Site design &amp; development</p>
            </div>
          </article>
        </div>
      </div>
    </div>
  </section>

  <ContactCta />
</BaseLayout>

<style>
  .about-page {
    max-width: 44rem;
  }

  .about-page h1 {
    font-size: clamp(2.2rem, 4.5vw, 3rem);
    margin: 0.4rem 0 0.9rem;
  }

  .about-page__survey {
    margin: 1rem 0 0;
    max-width: 40rem;
    font-size: 0.95rem;
  }

  .about-page__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  .about-survey {
    background: color-mix(in srgb, var(--green-light) 22%, var(--cream));
  }

  .about-survey__inner {
    max-width: 42rem;
  }

  .about-survey h2 {
    margin: 0.35rem 0 0.65rem;
    font-size: clamp(1.45rem, 2.8vw, 1.85rem);
  }

  .about-partners {
    background: color-mix(in srgb, var(--purple) 6%, var(--cream));
  }

  .about-partners h2 {
    margin: 0.35rem 0 0.65rem;
    font-size: clamp(1.6rem, 3vw, 2rem);
  }

  .about-partners__lede {
    max-width: 40rem;
    margin: 0 0 1.35rem;
  }

  .about-partners__logos {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    align-items: center;
  }

  .about-partners__logo {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem 1.25rem;
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--white) 82%, var(--cream));
    border: 1px solid color-mix(in srgb, var(--ink) 8%, transparent);
    text-decoration: none;
  }

  .about-partners__logo--brain {
    width: min(100%, 11rem);
  }

  .about-partners__logo--sky {
    width: min(100%, 18rem);
  }

  .about-partners__logo img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: contain;
  }

  .about-committee h2 {
    margin: 0.35rem 0 0.55rem;
    font-size: clamp(1.5rem, 3vw, 2rem);
    max-width: 28ch;
  }

  .about-committee__lede {
    max-width: 40rem;
    margin: 0 0 1.5rem;
  }

  .about-committee__groups {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.25rem);
    margin-top: 1.75rem;
  }

  .about-committee__group h3 {
    margin: 0 0 0.85rem;
    font-size: 0.95rem;
    color: var(--green);
  }

  .about-person-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: 0.85rem;
  }

  .about-person-card {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    margin: 0;
    padding: 1rem 1.05rem;
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--white) 78%, var(--cream));
    border: 1px solid color-mix(in srgb, var(--ink) 8%, transparent);
  }

  .about-person-card--featured {
    display: grid;
    grid-template-columns: 4.75rem 1fr;
    gap: 0.85rem;
    align-items: center;
    max-width: 26rem;
    padding: 0.75rem;
  }

  .about-person-card--chair {
    margin-top: 1.75rem;
    max-width: 24rem;
    border-color: color-mix(in srgb, var(--purple) 22%, transparent);
    background:
      linear-gradient(
        135deg,
        color-mix(in srgb, var(--purple) 8%, white),
        color-mix(in srgb, var(--white) 85%, var(--cream))
      );
  }

  .about-person-card--site {
    max-width: 24rem;
  }

  .about-committee__group--site {
    margin-top: 1.75rem;
  }

  .about-person-card__photo {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: calc(var(--radius-lg) - 0.35rem);
    background: color-mix(in srgb, var(--green-light) 30%, white);
  }

  .about-person-card--featured .about-person-card__photo {
    aspect-ratio: 1;
    max-width: 4.75rem;
  }

  .about-person-card__body {
    display: grid;
    gap: 0.2rem;
    min-width: 0;
  }

  .about-person-card__role {
    margin: 0;
    color: var(--green);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .about-person-card h3,
  .about-person-card h4 {
    margin: 0;
    font-size: 1.1rem;
    line-height: 1.25;
  }

  .about-person-card--featured h3,
  .about-person-card--chair h3 {
    font-size: 1.3rem;
  }

  .about-person-card__org {
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .about-person-card__email {
    margin-top: 0.35rem;
    color: var(--blue);
    font-size: 0.85rem;
    word-break: break-word;
    text-decoration: none;
  }

  .about-person-card__email:hover {
    text-decoration: underline;
  }

  @media (max-width: 800px) {
    .about-person-card--featured {
      grid-template-columns: 4.25rem 1fr;
    }
  }
</style>
