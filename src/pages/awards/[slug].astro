---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/ui/Button.astro";
import ContactCta from "../../components/layout/ContactCta.astro";
import { awardees, getAwardee, awardProfilePath } from "../../content/awards";
import { routes } from "../../config/site";
import { withBase } from "../../lib/paths";

export function getStaticPaths() {
  return awardees.map((person) => ({
    params: { slug: person.id },
  }));
}

const { slug } = Astro.params;
const person = getAwardee(slug!);

if (!person) {
  return Astro.redirect(withBase(routes.awards));
}

const idx = awardees.findIndex((p) => p.id === person.id);
const prev = awardees[idx - 1];
const next = awardees[idx + 1];

/** Prefer explicit gallery; otherwise show summit slide preview when a slides PDF exists. */
const slidePreview = person.slidesPdf
  ? {
      src: withBase(`/images/awards/slides/${person.id}.jpg`),
      alt: `Award slide for ${person.name}`,
      href: person.slidesPdf,
    }
  : null;
const gallery = person.gallery?.length
  ? person.gallery.map((img) => ({ ...img, href: person.slidesPdf }))
  : slidePreview
    ? [slidePreview]
    : [];
---

<BaseLayout title={person.name} description={person.summary}>
  <article class="section award-profile">
    <div class="container award-profile__grid">
      <div class="award-profile__media" data-reveal data-reveal-y="28">
        <img src={person.image} alt={person.imageAlt} width="480" height="600" />
        <span class="award-profile__year">{person.year}</span>
      </div>

      <div class="award-profile__copy" data-reveal data-reveal-delay="0.08" data-reveal-y="24">
        <p class="eyebrow">{person.recognition}</p>
        <p class="award-profile__stance">{person.stance}</p>
        <h1>{person.name}</h1>
        <p class="award-profile__institution">{person.institution}</p>
        <p class="award-profile__category">{person.category}</p>
        <p class="award-profile__summary">{person.summary}</p>
        <ul class="award-profile__focus">
          {person.focus.map((item) => <li>{item}</li>)}
        </ul>
        <div class="award-profile__actions">
          {
            person.certificateUrl && (
              <Button href={person.certificateUrl} external>
                View certificate
              </Button>
            )
          }
          {
            person.slidesPdf && (
              <Button
                href={person.slidesPdf}
                external
                variant={person.certificateUrl ? "secondary" : "primary"}
              >
                Download slides
              </Button>
            )
          }
          {
            person.proposalPdf && (
              <Button href={person.proposalPdf} external variant="secondary">
                Download proposal
              </Button>
            )
          }
          {
            person.pendingMedia && (
              <p class="award-profile__pending">
                Portrait and full project writeup are forthcoming.
              </p>
            )
          }
          <Button href={routes.awards} variant="secondary">All award winners</Button>
        </div>
      </div>
    </div>

    <nav class="container award-profile__nav" aria-label="Award winner pagination">
      {
        prev ? (
          <a class="award-profile__nav-link award-profile__nav-link--prev" href={withBase(awardProfilePath(prev.id))}>
            <span class="award-profile__nav-dir">Previous</span>
            <span class="award-profile__nav-name">
              <span aria-hidden="true">←</span>
              {prev.name}
            </span>
          </a>
        ) : (
          <span class="award-profile__nav-spacer" />
        )
      }
      {
        next ? (
          <a class="award-profile__nav-link award-profile__nav-link--next" href={withBase(awardProfilePath(next.id))}>
            <span class="award-profile__nav-dir">Next</span>
            <span class="award-profile__nav-name">
              {next.name}
              <span aria-hidden="true">→</span>
            </span>
          </a>
        ) : (
          <span class="award-profile__nav-spacer" />
        )
      }
    </nav>

    {
      person.certificateUrl && (
        <div class="container award-profile__cert" data-reveal data-reveal-y="24">
          <p class="eyebrow">Recognition</p>
          <h2>Award certificate</h2>
          <p class="muted award-profile__cert-lede">
            Official 2026 AI Innovator in Education Award certificate for {person.name}.
          </p>
          {
            person.certificateUrl.match(/\.(png|jpe?g|webp)$/i) ? (
              <figure class="award-profile__cert-figure">
                <a
                  href={person.certificateUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Open certificate for ${person.name}`}
                >
                  <img
                    src={person.certificateUrl}
                    alt={`Award certificate for ${person.name}`}
                    width="960"
                    height="720"
                  />
                </a>
              </figure>
            ) : (
              <Button href={person.certificateUrl} external>
                Open certificate PDF
              </Button>
            )
          }
        </div>
      )
    }

    {
      gallery.length > 0 && (
        <div class="container award-profile__gallery" data-reveal data-reveal-y="24">
          <p class="eyebrow">From the summit</p>
          <h2>Award slide</h2>
          <div class="award-profile__gallery-grid">
            {gallery.map((img) => (
              <figure>
                {img.href ? (
                  <a href={img.href} target="_blank" rel="noopener noreferrer" aria-label={`Download slides for ${person.name}`}>
                    <img src={img.src} alt={img.alt} width="960" height="540" />
                  </a>
                ) : (
                  <img src={img.src} alt={img.alt} width="960" height="540" />
                )}
              </figure>
            ))}
          </div>
        </div>
      )
    }
  </article>

  <ContactCta
    title="Questions about this recognition?"
    description="Write if you need clarification on a proposal, want to nominate a colleague, or are confirming faculty details for publication."
  />
</BaseLayout>

<style>
  .award-profile__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(1.5rem, 4vw, 2.75rem);
    align-items: start;
  }

  .award-profile__media {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    aspect-ratio: 4 / 5;
    max-width: 22rem;
    background: color-mix(in srgb, var(--green-light) 35%, white);
  }

  .award-profile__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .award-profile__year {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    padding: 0.45rem 0.75rem;
    border-radius: 0.7rem;
    background: color-mix(in srgb, var(--cream) 92%, white);
    color: var(--purple);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .award-profile__stance {
    margin: 0.35rem 0 0;
    color: var(--purple);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 700;
  }

  .award-profile h1 {
    margin: 0.35rem 0 0.4rem;
    font-size: clamp(2rem, 4.5vw, 2.85rem);
  }

  .award-profile__institution {
    margin: 0;
    color: var(--blue);
    font-weight: 600;
  }

  .award-profile__category {
    margin: 0.55rem 0 0;
    display: inline-flex;
    width: fit-content;
    padding: 0.22rem 0.55rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--blue) 14%, white);
    color: var(--blue);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .award-profile__summary {
    margin: 1rem 0 0;
    color: var(--muted);
    font-size: 1.05rem;
    max-width: 38rem;
  }

  .award-profile__focus {
    list-style: none;
    margin: 1.1rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .award-profile__focus li {
    font-size: 0.78rem;
    font-weight: 600;
    padding: 0.3rem 0.65rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--purple) 12%, white);
    color: var(--ink);
  }

  .award-profile__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .award-profile__pending {
    margin: 0;
    flex: 1 1 100%;
    color: var(--muted);
    font-size: 0.92rem;
    font-style: italic;
  }

  .award-profile__cert {
    margin-top: clamp(1.75rem, 4vw, 2.5rem);
  }

  .award-profile__cert h2 {
    margin: 0.35rem 0 0.5rem;
    font-size: clamp(1.45rem, 2.8vw, 1.85rem);
  }

  .award-profile__cert-lede {
    margin: 0 0 1rem;
    max-width: 36rem;
  }

  .award-profile__cert-figure {
    margin: 0;
    max-width: 42rem;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--ink) 8%, transparent);
    background: color-mix(in srgb, var(--white) 80%, var(--cream));
  }

  .award-profile__cert-figure img {
    display: block;
    width: 100%;
    height: auto;
  }

  .award-profile__gallery {
    margin-top: clamp(1.75rem, 4vw, 2.5rem);
  }

  .award-profile__gallery h2 {
    margin: 0.35rem 0 1rem;
    font-size: clamp(1.45rem, 2.5vw, 1.85rem);
  }

  .award-profile__gallery-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    max-width: 52rem;
  }

  .award-profile__gallery-grid figure {
    margin: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background: color-mix(in srgb, var(--ink) 88%, var(--purple));
    box-shadow: 0 12px 32px color-mix(in srgb, var(--ink) 12%, transparent);
  }

  .award-profile__gallery-grid a {
    display: block;
    width: 100%;
    height: 100%;
  }

  .award-profile__gallery-grid img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .award-profile__nav {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2.25rem;
    margin-bottom: 0.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid color-mix(in srgb, var(--purple) 16%, transparent);
  }

  .award-profile__nav-spacer {
    flex: 1;
    max-width: min(20rem, 48%);
  }

  .award-profile__nav-link {
    flex: 1;
    max-width: min(20rem, 48%);
    display: grid;
    gap: 0.35rem;
    padding: 0.95rem 1.15rem;
    border-radius: var(--radius-lg);
    text-decoration: none;
    background: color-mix(in srgb, var(--white) 72%, var(--cream));
    border: 1px solid color-mix(in srgb, var(--green) 22%, transparent);
    color: var(--ink);
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.2s ease,
      background-color 0.2s ease;
  }

  .award-profile__nav-link--next {
    text-align: right;
    margin-left: auto;
  }

  .award-profile__nav-dir {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--green);
  }

  .award-profile__nav-name {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 2vw, 1.2rem);
    font-weight: 600;
    line-height: 1.25;
    color: var(--ink);
  }

  .award-profile__nav-link--next .award-profile__nav-name {
    justify-content: flex-end;
  }

  .award-profile__nav-link:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--purple) 35%, transparent);
    background: color-mix(in srgb, var(--purple) 6%, var(--cream));
    box-shadow: 0 10px 24px color-mix(in srgb, var(--ink) 8%, transparent);
  }

  .award-profile__nav-link:hover .award-profile__nav-dir {
    color: var(--purple);
  }

  @media (max-width: 800px) {
    .award-profile__grid {
      grid-template-columns: 1fr;
      justify-items: center;
    }

    .award-profile__copy {
      justify-self: stretch;
    }

    .award-profile__media {
      max-width: 16rem;
      width: 100%;
    }

    .award-profile__nav {
      flex-direction: column;
    }

    .award-profile__nav-link,
    .award-profile__nav-spacer {
      max-width: none;
      width: 100%;
    }

    .award-profile__nav-link--next {
      text-align: left;
      margin-left: 0;
    }

    .award-profile__nav-link--next .award-profile__nav-name {
      justify-content: flex-start;
    }
  }
</style>
