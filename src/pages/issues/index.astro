---
import BaseLayout from "../../layouts/BaseLayout.astro";
import StatRow from "../../components/ui/StatRow.astro";
import IssueList from "../../components/issues/IssueList.astro";
import Button from "../../components/ui/Button.astro";
import ContactCta from "../../components/layout/ContactCta.astro";
import { site } from "../../content/site";
import { stats } from "../../content/stats";

const reportStats = [
  { value: stats.respondents.value, label: stats.respondents.label, color: "green-light" as const },
  { value: stats.aiActive.value, label: stats.aiActive.label, color: "blue" as const },
  { value: stats.criticalThinking.value, label: stats.criticalThinking.label, color: "purple" as const },
];
---

<BaseLayout
  title="Top 10 Issues"
  description="Ten issues facing WNC educators in the age of AI—from the 2026 educator survey and regional summits."
>
  <section class="section issues-report">
    <div class="container issues-report__intro">
      <p class="eyebrow">Regional report</p>
      <h1>Top 10 Issues Facing Educators</h1>
      <p class="issues-report__dek">
        Based on the 2026 WNC Educator Survey and regional educator summits. These are not
        hypothetical future problems—they are showing up in classrooms across the region now.
      </p>
      <div class="prose muted issues-report__overview">
        <p>
          The 2026 WNC Educator Survey makes the picture clear: {stats.aiActive.value} of the faculty
          who engage with AI are already using these tools, {stats.policyBehind.value} say their
          institution’s policy is behind or nonexistent, and {stats.criticalThinking.value} name loss
          of critical thinking as their leading concern. Students feel the pressure too. Roughly 70%
          of college students now see AI as a danger to their future careers.
        </p>
        <p>
          One principle ties all ten issues together, simple enough for a sticky note:
          <strong>{site.tagline}</strong> Used well, AI extends what a capable person can do. Used as
          a substitute for learning, it removes the work that builds human understanding and
          capability in the first place.
        </p>
      </div>
      <StatRow stats={reportStats} />
      <div class="issues-report__actions">
        <Button href={site.fullReportUrl} external>Full written analysis</Button>
        <Button href="/schools" variant="secondary">What schools are doing</Button>
      </div>
    </div>
  </section>

  <section class="section section--tight issues-report__list">
    <div class="container">
      <p class="eyebrow issues-report__list-eyebrow">The ten issues</p>
      <IssueList />
    </div>
  </section>

  <section class="section section--tight">
    <div class="container issues-report__footer">
      <blockquote>
        <p>
          “The desire to thoughtfully integrate AI while maintaining educational values centered on
          human interaction, critical thinking, and ethical responsibility.”
        </p>
        <footer>Warren Wilson College educator respondents, 2026</footer>
      </blockquote>

      <div class="issues-report__authors">
        <p class="eyebrow">Created by</p>
        <div class="issues-report__authors-grid">
          {
            site.authors.map((author) => (
              <figure>
                <img src={author.image} alt={author.name} />
                <figcaption>
                  <strong>{author.name}</strong>
                  <span>{author.role}</span>
                </figcaption>
              </figure>
            ))
          }
        </div>
        <Button href={site.voteUrl} external>Vote on priorities</Button>
      </div>
    </div>
  </section>

  <ContactCta />
</BaseLayout>

<style>
  .issues-report__intro {
    max-width: 46rem;
  }

  .issues-report h1 {
    font-size: clamp(2.3rem, 5vw, 3.35rem);
    margin: 0.4rem 0 0.85rem;
    max-width: 16ch;
  }

  .issues-report__dek {
    margin: 0 0 1.25rem;
    color: var(--muted);
    font-size: 1.1rem;
  }

  .issues-report__overview {
    margin-bottom: 1.5rem;
  }

  .issues-report__overview strong {
    color: var(--purple);
    font-weight: 700;
  }

  .issues-report__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .issues-report__list {
    background: color-mix(in srgb, var(--green-light) 12%, var(--cream));
  }

  .issues-report__list-eyebrow {
    text-align: center;
    margin-bottom: 0.5rem;
  }

  .issues-report__footer {
    display: grid;
    gap: 2.5rem;
    max-width: 46rem;
  }

  .issues-report__footer blockquote {
    margin: 0;
    padding: 1.35rem 0;
    border-top: 1px solid color-mix(in srgb, var(--purple) 18%, transparent);
    border-bottom: 1px solid color-mix(in srgb, var(--purple) 18%, transparent);
  }

  .issues-report__footer blockquote p {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.5vw, 1.55rem);
    line-height: 1.35;
    color: var(--ink);
  }

  .issues-report__footer blockquote footer {
    margin-top: 0.85rem;
    color: var(--muted);
    font-size: 0.92rem;
  }

  .issues-report__authors-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 10rem));
    gap: 1.25rem;
    margin: 1rem 0 1.35rem;
  }

  .issues-report__authors img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--blue) 20%, white);
  }

  .issues-report__authors figcaption {
    display: grid;
    margin-top: 0.55rem;
  }

  .issues-report__authors figcaption span {
    color: var(--muted);
    font-size: 0.9rem;
  }
</style>
