---
import BaseLayout from "../../layouts/BaseLayout.astro";
import StatRow from "../../components/ui/StatRow.astro";
import IssueList from "../../components/issues/IssueList.astro";
import Button from "../../components/ui/Button.astro";
import ContactCta from "../../components/layout/ContactCta.astro";
import { site, surveyAttribution } from "../../content/site";
import { stats } from "../../content/stats";
import { issueFilters, issues } from "../../content/issues";
import { routes } from "../../config/site";

const reportStats = [
  { value: stats.aiActive.value, label: stats.aiActive.label, color: "blue" as const },
  { value: stats.criticalThinking.value, label: stats.criticalThinking.label, color: "purple" as const },
  { value: stats.policyBehind.value, label: stats.policyBehind.label, color: "green-light" as const },
];
---

<BaseLayout
  title="Top 10 Issues"
  description="Ten issues facing WNC educators in the age of AI—from the 2026 educator survey and regional summits."
>
  <section class="section issues-report">
    <div class="container issues-report__intro">
      <p class="eyebrow">Regional report</p>
      <h1>Top 10 Issues in AI Facing Educators</h1>
      <p class="issues-report__dek">
        From the {surveyAttribution.name} ({surveyAttribution.when}) and the regional summits. These
        aren’t future problems—they’re already showing up in classrooms across WNC.
      </p>
      <div class="prose muted issues-report__overview">
        <p>{surveyAttribution.blurb}</p>
        <p>
          The survey makes the picture clear: {stats.aiActive.value} of AI-active faculty already use
          these tools, {stats.policyBehind.value} say policy is behind or nonexistent, and
          {stats.criticalThinking.value} name loss of critical thinking as their leading concern.
        </p>
        <p>
          One principle ties all ten together: <strong>{site.tagline}</strong> Used well, AI extends
          what a capable person can do. Used as a substitute for learning, it removes the work that
          builds understanding.
        </p>
      </div>
      <StatRow stats={reportStats} />
      <div class="issues-report__actions">
        {
          site.fullReportUrl ? (
            <Button href={site.fullReportUrl} external>
              Full written analysis (PDF)
            </Button>
          ) : (
            <Button href="#the-ten-issues">Browse the ten issues</Button>
          )
        }
        <Button href={routes.schools} variant="secondary">What schools are doing with AI</Button>
      </div>
    </div>
  </section>

  <section class="section section--tight issues-report__list" id="the-ten-issues">
    <div class="container">
      <p class="eyebrow issues-report__list-eyebrow">The ten issues</p>

      <nav class="issues-jump" aria-label="Jump to issue">
        {
          issues.map((issue) => (
            <a href={`#issue-${issue.number}`} data-jump={issue.number}>
              {issue.number}
            </a>
          ))
        }
      </nav>

      <div class="issues-filters" role="toolbar" aria-label="Filter issues">
        {
          issueFilters.map((filter, index) => (
            <button
              type="button"
              class:list={["issues-filters__btn", { "is-active": index === 0 }]}
              data-issue-filter={filter.id}
            >
              {filter.label}
            </button>
          ))
        }
      </div>

      <p class="issues-count" data-issues-count aria-live="polite">Showing {issues.length} issues</p>

      <IssueList />
      <p class="issues-empty" data-issues-empty hidden>No issues in this filter.</p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container issues-report__footer">
      <blockquote>
        <p>
          “The desire to thoughtfully integrate AI while maintaining educational values centered on
          human interaction, critical thinking, and ethical responsibility.”
        </p>
        <footer>Warren Wilson College educator respondents, 2026</footer>
      </blockquote>

      <div class="issues-report__authors">
        <p class="eyebrow">Created by</p>
        <div class="issues-report__authors-grid">
          {
            site.authors.map((author) => (
              <figure>
                <img src={author.image} alt={author.name} />
                <figcaption>
                  <strong>{author.name}</strong>
                  <span>{author.role}</span>
                </figcaption>
              </figure>
            ))
          }
        </div>
        {
          site.voteUrl ? (
            <Button href={site.voteUrl} external>
              Vote on priorities
            </Button>
          ) : null
        }
      </div>
    </div>
  </section>

  <ContactCta />
</BaseLayout>

<script>
  const filterButtons = document.querySelectorAll<HTMLButtonElement>("[data-issue-filter]");
  const cards = document.querySelectorAll<HTMLElement>("[data-issue-card]");
  const countEl = document.querySelector<HTMLElement>("[data-issues-count]");
  const emptyEl = document.querySelector<HTMLElement>("[data-issues-empty]");
  const jumpLinks = document.querySelectorAll<HTMLAnchorElement>("[data-jump]");

  function applyFilter(category: string) {
    let visible = 0;
    cards.forEach((card) => {
      const match = category === "all" || card.dataset.category === category;
      card.hidden = !match;
      if (match) visible += 1;
    });
    if (countEl) {
      countEl.textContent = `Showing ${visible} issue${visible === 1 ? "" : "s"}`;
    }
    if (emptyEl) emptyEl.hidden = visible > 0;

    jumpLinks.forEach((link) => {
      const num = link.dataset.jump;
      const card = document.getElementById(`issue-${num}`);
      link.hidden = !card || card.hidden;
    });
  }

  filterButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      filterButtons.forEach((b) => b.classList.toggle("is-active", b === btn));
      applyFilter(btn.dataset.issueFilter || "all");
    });
  });

  document.querySelectorAll<HTMLButtonElement>("[data-issue-toggle]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const card = btn.closest<HTMLElement>("[data-issue-card]");
      if (!card) return;
      const panel = card.querySelector<HTMLElement>("[data-issue-panel]");
      const open = !card.classList.contains("is-open");
      card.classList.toggle("is-open", open);
      btn.setAttribute("aria-expanded", String(open));
      if (panel) panel.hidden = !open;
    });
  });

  jumpLinks.forEach((link) => {
    link.addEventListener("click", (event) => {
      const target = document.getElementById(`issue-${link.dataset.jump}`);
      if (!target || target.hidden) return;
      event.preventDefault();
      target.scrollIntoView({ behavior: "smooth", block: "start" });
      const toggle = target.querySelector<HTMLButtonElement>("[data-issue-toggle]");
      if (toggle && !target.classList.contains("is-open")) toggle.click();
    });
  });
</script>

<style>
  .issues-report__intro {
    max-width: 46rem;
  }

  .issues-report h1 {
    font-size: clamp(2.3rem, 5vw, 3.35rem);
    margin: 0.4rem 0 0.85rem;
    max-width: 16ch;
  }

  .issues-report__dek {
    margin: 0 0 1.25rem;
    color: var(--muted);
    font-size: 1.1rem;
  }

  .issues-report__overview {
    margin-bottom: 1.5rem;
  }

  .issues-report__overview strong {
    color: var(--purple);
    font-weight: 700;
  }

  .issues-report__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .issues-report__list {
    background: color-mix(in srgb, var(--green-light) 12%, var(--cream));
  }

  .issues-report__list-eyebrow {
    text-align: center;
    margin-bottom: 0.85rem;
  }

  .issues-jump {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem;
    margin-bottom: 1rem;
  }

  .issues-jump a {
    width: 2.35rem;
    height: 2.35rem;
    display: grid;
    place-items: center;
    border-radius: 0.65rem;
    text-decoration: none;
    font-weight: 700;
    color: var(--ink);
    background: color-mix(in srgb, var(--white) 70%, var(--cream));
    transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }

  .issues-jump a:hover {
    background: var(--green);
    color: var(--white);
    transform: translateY(-2px);
  }

  .issues-jump a[hidden] {
    display: none !important;
  }

  .issues-filters {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.45rem;
    margin-bottom: 0.75rem;
  }

  .issues-filters__btn {
    border: 0;
    cursor: pointer;
    font: inherit;
    font-size: 0.85rem;
    font-weight: 600;
    padding: 0.45rem 0.9rem;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--white) 65%, var(--cream));
    color: var(--muted);
    transition: background 0.2s ease, color 0.2s ease;
  }

  .issues-filters__btn:hover {
    color: var(--ink);
    background: color-mix(in srgb, var(--green-light) 45%, white);
  }

  .issues-filters__btn.is-active {
    background: var(--purple);
    color: var(--white);
  }

  .issues-count {
    text-align: center;
    color: var(--muted);
    font-size: 0.9rem;
    margin: 0 0 1.15rem;
  }

  .issues-empty {
    text-align: center;
    color: var(--muted);
    margin-top: 1rem;
  }

  .issues-empty[hidden] {
    display: none !important;
  }

  .issues-report__footer {
    display: grid;
    gap: 2.5rem;
    max-width: 46rem;
  }

  .issues-report__footer blockquote {
    margin: 0;
    padding: 1.35rem 0;
    border-top: 1px solid color-mix(in srgb, var(--purple) 18%, transparent);
    border-bottom: 1px solid color-mix(in srgb, var(--purple) 18%, transparent);
  }

  .issues-report__footer blockquote p {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.5vw, 1.55rem);
    line-height: 1.35;
    color: var(--ink);
  }

  .issues-report__footer blockquote footer {
    margin-top: 0.85rem;
    color: var(--muted);
    font-size: 0.92rem;
  }

  .issues-report__authors-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 10rem));
    gap: 1.25rem;
    margin: 1rem 0 1.35rem;
  }

  .issues-report__authors img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--blue) 20%, white);
  }

  .issues-report__authors figcaption {
    display: grid;
    margin-top: 0.55rem;
  }

  .issues-report__authors figcaption span {
    color: var(--muted);
    font-size: 0.9rem;
  }
</style>
