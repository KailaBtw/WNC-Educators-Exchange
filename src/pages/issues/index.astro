---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHeader from "../../components/ui/SectionHeader.astro";
import IssueList from "../../components/issues/IssueList.astro";
import Button from "../../components/ui/Button.astro";
import ContactCta from "../../components/layout/ContactCta.astro";
import { site } from "../../content/site";
import { stats } from "../../content/stats";
---

<BaseLayout
  title="Top 10 Issues"
  description="Ten issues facing WNC educators in the age of AI—from the 2026 educator survey and regional summits."
>
  <section class="section">
    <div class="container">
      <SectionHeader
        eyebrow="Regional report"
        title="Top 10 Issues in AI facing WNC educators"
        align="center"
      >
        <p>
          The 2026 WNC Educator Survey makes the picture clear: {stats.aiActive.value} of AI-active
          faculty are already using these tools, {stats.policyBehind.value} say institutional policy
          is behind or nonexistent, and {stats.criticalThinking.value} name loss of critical thinking
          as their leading concern.
        </p>
      </SectionHeader>

      <blockquote class="issues-quote">
        <p>{site.tagline}</p>
        <footer>
          Used well, AI extends what a capable person can do. Used as a substitute for learning, it
          removes the work that builds understanding.
        </footer>
      </blockquote>

      <div class="issues-resources">
        <a href={site.fullReportUrl} target="_blank" rel="noopener noreferrer">Full report</a>
        <a href={site.campusesDoingUrl} target="_blank" rel="noopener noreferrer"
          >What campuses are doing</a
        >
        <a href={site.educatorProjectsUrl} target="_blank" rel="noopener noreferrer"
          >Educator projects in AI</a
        >
      </div>

      <IssueList />

      <div class="issues-authors">
        <p class="eyebrow">Created by</p>
        <div class="issues-authors__grid">
          {
            site.authors.map((author) => (
              <figure>
                <img src={author.image} alt={author.name} />
                <figcaption>
                  <strong>{author.name}</strong>
                  <span>{author.role}</span>
                </figcaption>
              </figure>
            ))
          }
        </div>
        <div class="issues-authors__vote">
          <Button href={site.voteUrl} external>Vote on priorities</Button>
        </div>
      </div>
    </div>
  </section>
  <ContactCta />
</BaseLayout>

<style>
  .issues-quote {
    margin: 0 auto 2rem;
    max-width: 40rem;
    text-align: center;
    padding: 1.5rem;
    border-top: 1px solid color-mix(in srgb, var(--purple) 25%, transparent);
    border-bottom: 1px solid color-mix(in srgb, var(--purple) 25%, transparent);
  }

  .issues-quote p {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    color: var(--purple);
  }

  .issues-quote footer {
    margin-top: 0.75rem;
    color: var(--muted);
  }

  .issues-resources {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.85rem;
    margin-bottom: 2rem;
  }

  .issues-resources a {
    display: grid;
    place-items: center;
    text-align: center;
    min-height: 4.5rem;
    padding: 1rem;
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--green-light) 40%, white);
    color: var(--green);
    font-weight: 700;
    text-decoration: none;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-size: 0.8rem;
  }

  .issues-resources a:hover {
    background: color-mix(in srgb, var(--purple) 12%, white);
    color: var(--purple);
  }

  .issues-authors {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid color-mix(in srgb, var(--purple) 18%, transparent);
  }

  .issues-authors__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 10rem));
    gap: 1.25rem;
    margin-top: 1rem;
  }

  .issues-authors img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--blue) 20%, white);
  }

  .issues-authors figcaption {
    display: grid;
    margin-top: 0.55rem;
  }

  .issues-authors figcaption span {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .issues-authors__vote {
    margin-top: 1.5rem;
  }

  @media (max-width: 700px) {
    .issues-resources {
      grid-template-columns: 1fr;
    }
  }
</style>
