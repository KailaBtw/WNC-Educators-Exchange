---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeader from "../components/ui/SectionHeader.astro";
import ContactCta from "../components/layout/ContactCta.astro";
import { schoolPractices, schoolsIntro } from "../content/schools";
---

<BaseLayout
  title="What Schools Are Doing"
  description="Campus AI practices across Western North Carolina—policy frameworks, faculty development, and classroom redesign."
>
  <section class="section">
    <div class="container">
      <div data-reveal>
        <SectionHeader eyebrow={schoolsIntro.eyebrow} title={schoolsIntro.title} align="center">
          <p>{schoolsIntro.description}</p>
        </SectionHeader>
      </div>

      <div class="schools-list">
        {
          schoolPractices.map((practice, index) => (
            <article
              class="school-item"
              data-reveal
              data-reveal-delay={String(0.04 * (index % 4))}
              data-reveal-y="28"
            >
              <p class="school-item__institution">{practice.institution}</p>
              <h3>{practice.title}</h3>
              <p class="school-item__summary">{practice.summary}</p>
              {practice.detail.map((paragraph) => (
                <p class="school-item__detail">{paragraph}</p>
              ))}
              {practice.link && (
                <p>
                  <a href={practice.link.href} target="_blank" rel="noopener noreferrer">
                    {practice.link.label}
                  </a>
                </p>
              )}
            </article>
          ))
        }
      </div>
    </div>
  </section>
  <ContactCta />
</BaseLayout>

<style>
  .schools-list {
    display: grid;
    gap: 0;
    max-width: 48rem;
    margin-inline: auto;
  }

  .school-item {
    padding: 1.5rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--purple) 14%, transparent);
  }

  .school-item:first-child {
    border-top: 1px solid color-mix(in srgb, var(--purple) 14%, transparent);
  }

  .school-item__institution {
    color: var(--blue);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 700;
    margin-bottom: 0.35rem;
  }

  .school-item h3 {
    font-size: 1.45rem;
    margin-bottom: 0.55rem;
  }

  .school-item__summary {
    color: var(--ink);
    margin-bottom: 0.65rem;
  }

  .school-item__detail {
    color: var(--muted);
    margin-bottom: 0.55rem;
  }

  .school-item a {
    color: var(--green);
    font-weight: 600;
    text-decoration: none;
  }

  .school-item a:hover {
    color: var(--purple);
  }
</style>
