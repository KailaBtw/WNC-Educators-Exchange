---
import "../styles/global.css";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import ScrollMotionRoot from "../components/ui/ScrollMotionRoot";
import { site } from "../content/site";
import { assets } from "../config/site";
import { asset, assetVarName, cssUrl } from "../lib/paths";

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.description } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : site.name;

/** One place: CSS can use var(--asset-*) without knowing the Pages base path. */
const assetVars = Object.entries(assets)
  .map(([key, path]) => `${assetVarName(key)}: ${cssUrl(path)}`)
  .join("; ");
---

<!doctype html>
<html lang="en" style={assetVars}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={asset("favicon")} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;500;600;700&family=Source+Serif+4:opsz,wght@8..60,500;8..60,600;8..60,700&display=swap"
      rel="stylesheet"
    />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <ScrollMotionRoot client:load />
  </body>
</html>

<style is:global>
  body {
    display: flex;
    flex-direction: column;
  }

  main {
    flex: 1;
  }

  .skip-link {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
    z-index: 100;
    background: var(--ink);
    color: var(--white);
    font-size: 0.88rem;
    font-weight: 700;
    text-decoration: none;
  }

  .skip-link:focus {
    width: auto;
    height: auto;
    margin: 0;
    clip: auto;
    overflow: visible;
    white-space: normal;
    left: var(--page-gutter);
    top: 0.75rem;
    padding: 0.55rem 0.95rem;
    border-radius: var(--radius-pill);
    outline: 2px solid var(--green-light);
    outline-offset: 2px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-reveal] {
      opacity: 1 !important;
      transform: none !important;
      filter: none !important;
    }
  }
</style>
